stdint.h>\n37\t#endif\n38\t\n39\t/****************************************************************************\n40\t * Pre-processor Definitions\n41\t ****************************************************************************/\n42\t\n43\t/* Clocking *****************************************************************/\n44\t/* Clock tree (single PLL1 fed from the internal HSI):\n45\t *\n46\t *   HSI 64 MHz / M=4 * N=50 = 800 MHz VCO\n47\t *     IC1  /4 = 200 MHz  -> CPU clock (CPUSW)\n48\t *     IC2  /8 = 100 MHz  \\\n49\t *     IC6 /12 = 66.7 MHz  > SYSCLK components (SYSSW IC2_IC6_IC11)\n50\t *     IC11 /8 = 100 MHz  /\n51\t *   HPRE /2  = 50 MHz   -> HCLK\n52\t *   PPRE1 /1 = 50 MHz   -> PCLK1\n53\t *   PPRE2 /1 = 50 MHz   -> PCLK2\n54\t *\n55\t * Works with the default VOS SCALE1, no SMPS overdrive required.\n56\t */\n57\t\n58\t#define STM32_HSI_FREQUENCY     64000000ul\n59\t\n60\t#define STM32_PLL1_M            4\n61\t#define STM32_PLL1_N            50\n62\t#define STM32_PLL1_IC1_DIV      4\n63\t\n64\t#define STM32_CPUCLK_FREQUENCY  200000000ul\n65\t#define STM32_SYSCLK_FREQUENCY  (STM32_CPUCLK_FREQUENCY / 2)\n66\t#define STM32_HCLK_FREQUENCY    (STM32_CPUCLK_FREQUENCY / 4)\n67\t#define STM32_PCLK1_FREQUENCY   STM32_HCLK_FREQUENCY\n68\t#define STM32_PCLK2_FREQUENCY   STM32_HCLK_FREQUENCY\n69\t\n70\t/* Timer input clock = SYSCLK (TIMPRE=0 default) */\n71\t\n72\t#define STM32_APB1_TIM_FREQUENCY STM32_SYSCLK_FREQUENCY\n73\t#define STM32_APB2_TIM_FREQUENCY STM32_SYSCLK_FREQUENCY\n74\t\n75\t/* I/O voltage domains ******************************************************/\n76\t/* GPIO port E (USART1 TX/RX on PE5/PE6) is on the VddIO2 and VddIO3\n77\t * domains; both are wired to the board's 1.8 V rail.\n78\t */\n79\t\n80\t#define BOARD_PWR_VDDIO  (PWR_SVMCR3_VDDIO2SV    | PWR_SVMCR3_VDDIO3SV | \\\n81\t                          PWR_SVMCR3_VDDIO2VRSEL | PWR_SVMCR3_VDDIO3VRSEL)\n82\t\n83\t/* LED definitions **********************************************************/\n84\t/* The Nucleo-N657X0-Q has three user LEDs (UM3417 silkscreen):\n85\t *\n86\t *   LD5  PG10  Red\n87\t *   LD6  PG0   Green\n88\t *   LD7  PG8   Blue\n89\t *\n90\t * Active LOW: pin LOW = LED on.\n91\t */\n92\t\n93\t#define BOARD_LED1        0\n94\t#define BOARD_LED2        1\n95\t#define BOARD_LED3        2\n96\t#define BOARD_NLEDS       3\n97\t\n98\t#define BOARD_LED_RED     BOARD_LED1\n99\t#define BOARD_LED_GREEN   BOARD_LED2\n100\t#define BOARD_LED_BLUE    BOARD_LED3\n101\t\n102\t#define BOARD_LED1_BIT    (1 << BOARD_LED1)\n103\t#define BOARD_LED2_BIT    (1 << BOARD_LED2)\n104\t#define BOARD_LED3_BIT    (1 << BOARD_LED3)\n105\t\n106\t/* LED state encoding for CONFIG_ARCH_LEDS */\n107\t\n108\t#define LED_STARTED        0 /* NuttX has been started   OFF    OFF   OFF  */\n109\t#define LED_HEAPALLOCATE   1 /* Heap has been allocated  OFF    OFF   ON   */\n110\t#define LED_IRQSENABLED    2 /* Interrupts enabled       OFF    ON    OFF  */\n111\t#define LED_STACKCREATED   3 /* Idle stack created       OFF    ON    ON   */\n112\t#define LED_INIRQ          4 /* In an interrupt          N/C    N/C   GLOW */\n113\t#define LED_SIGNAL         5 /* In a signal handler      N/C    GLOW  N/C  */\n114\t#define LED_ASSERTION      6 /* An assertion failed      GLOW   N/C   GLOW */\n115\t#define LED_PANIC          7 /* The system has crashed   Blink  OFF   N/C  */\n116\t#define LED_IDLE           8 /* MCU is in sleep mode     ON     OFF   OFF  */\n117\t\n118\t/* Alternate function pin selections ****************************************/\n119\t/* USART1 (Nucleo Virtual Console): PE5=TX (AF7), PE6=RX (AF7)\n120\t * Connected to the on-board ST-Link to provide a Virtual COM Port.\n121\t */\n122\t\n123\t#define GPIO_USART1_TX   GPIO_USART1_TX_1\n124\t#define GPIO_USART1_RX   GPIO_USART1_RX_1\n125\t\n126\t/****************************************************************************\n127\t * Public Data\n128\t ****************************************************************************/\n129\t\n130\t#ifndef __ASSEMBLY__\n131\t\n132\t#undef EXTERN\n133\t#if defined(__cplusplus)\n134\t#define EXTERN extern \"C\"\n135\textern \"C\"\n136\t{\n137\t#else\n138\t#define EXTERN extern\n139\t#endif\n140\t\n141\t/****************************************************************************\n142\t * Public Function Prototypes\n143\t ****************************************************************************/\n144\t\n145\t/****************************************************************************\n146\t * Name: stm32_board_initialize\n147\t *\n148\t * Description:\n149\t *   All STM32N6 architectures must provide the following entry point.\n150\t *   This entry point is called early in the initialization -- after all\n151\t *   memory has been configured and mapped but before any devices\n152\t *   have been initialized.\n153\t *\n154\t ****************************************************************************/\n155\t\n156\tvoid stm32_board_initialize(void);\n157\t\n158\t#undef EXTERN\n159\t#if defined(__cplusplus)\n160\t}\n161\t#endif\n162\t\n163\t#endif /* __ASSEMBLY__ */\n164\t#endif /* __VENDOR_OPENVELA_BOARDS_CONTEST2026_224_BOARD_INCLUDE_BOARD_H */\n165\t"}]},"uuid":"9bf36bd2-4841-456b-8c76-295da42ddd3f","timestamp":"2026-08-21T14:18:45.496Z","toolUseResult":{"type":"text","file":{"filePath":"/home/warner/openvela/contest2026_224_quanyuanzhirendui/board/contest_board/include/board.h","content":"/****************************************************************************\n * vendor/openvela/boards/contest2026_224_board/include/board.h\n *\n * NUCLEO-N657X0-Q board definitions for STM32N657X0 (Cortex-M55).\n *\n * Adapted from nuttx/boards/arm/stm32n6/nucleo-n657x0-q/\n *\n * SPDX-License-Identifier: Apache-2.0\n *\n * Licensed to the Apache Software Foundation (ASF) under one or more\n * contributor license agreements.  See the NOTICE file distributed with\n * this work for additional information regarding copyright ownership.  The\n * ASF licenses this file to you under the Apache License, Version 2.0 (the\n * \"License\"); you may not use this file except in compliance with the\n * License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n * License for the specific language governing permissions and limitations\n * under the License.\n *\n ****************************************************************************/\n\n#ifndef __VENDOR_OPENVELA_BOARDS_CONTEST2026_224_BOARD_INCLUDE_BOARD_H\n#define __VENDOR_OPENVELA_BOARDS_CONTEST2026_224_BOARD_INCLUDE_BOARD_H\n\n/****************************************************************************\n * Included Files\n ****************************************************************************/\n\n#include <nuttx/config.h>\n#ifndef __ASSEMBLY__\n#  include <stdint.h>\n#endif\n\n/****************************************************************************\n * Pre-processor Definitions\n ****************************************************************************/\n\n/* Clocking *****************************************************************/\n/* Clock tree (single PLL1 fed from the internal HSI):\n *\n *   HSI 64 MHz / M=4 * N=50 = 800 MHz VCO\n *     IC1  /4 = 200 MHz  -> CPU clock (CPUSW)\n *     IC2  /8 = 100 MHz  \\\n *     IC6 /12 = 66.7 MHz  > SYSCLK components (SYSSW IC2_IC6_IC11)\n *     IC11 /8 = 100 MHz  /\n *   HPRE /2  = 50 MHz   -> HCLK\n *   PPRE1 /1 = 50 MHz   -> PCLK1\n *   PPRE2 /1 = 50 MHz   -> PCLK2\n *\n * Works with the default VOS SCALE1, no SMPS overdrive required.\n */\n\n#define STM32_HSI_FREQUENCY     64000000ul\n\n#define STM32_PLL1_M            4\n#define STM32_PLL1_N            50\n#define STM32_PLL1_IC1_DIV      4\n\n#define STM32_CPUCLK_FREQUENCY  200000000ul\n#define STM32_SYSCLK_FREQUENCY  (STM32_CPUCLK_FREQUENCY / 2)\n#define STM32_HCLK_FREQUENCY    (STM32_CPUCLK_FREQUENCY / 4)\n#define STM32_PCLK1_FREQUENCY   STM32_HCLK_FREQUENCY\n#define STM32_PCLK2_FREQUENCY   STM32_HCLK_FREQUENCY\n\n/* Timer input clock = SYSCLK (TIMPRE=0 default) */\n\n#define STM32_APB1_TIM_FREQUENCY STM32_SYSCLK_FREQUENCY\n#define STM32_APB2_TIM_FREQUENCY STM32_SYSCLK_FREQUENCY\n\n/* I/O voltage domains ******************************************************/\n/* GPIO port E (USART1 TX/RX on PE5/PE6) is on the VddIO2 and VddIO3\n * domains; both are wired to the board's 1.8 V rail.\n */\n\n#define BOARD_PWR_VDDIO  (PWR_SVMCR3_VDDIO2SV    | PWR_SVMCR3_VDDIO3SV | \\\n                          PWR_SVMCR3_VDDIO2VRSEL | PWR_SVMCR3_VDDIO3VRSEL)\n\n/* LED definitions **********************************************************/\n/* The Nucleo-N657X0-Q has three user LEDs (UM3417 silkscreen):\n *\n *   LD5  PG10  Red\n *   LD6  PG0   Green\n *   LD7  PG8   Blue\n *\n * Active LOW: pin LOW = LED on.\n */\n\n#define BOARD_LED1        0\n#define BOARD_LED2        1\n#define BOARD_LED3        2\n#define BOARD_NLEDS       3\n\n#define BOARD_LED_RED     BOARD_LED1\n#define BOARD_LED_GREEN   BOARD_LED2\n#define BOARD_LED_BLUE    BOARD_LED3\n\n#define BOARD_LED1_BIT    (1 << BOARD_LED1)\n#define BOARD_LED2_BIT    (1 << BOARD_LED2)\n#define BOARD_LED3_BIT    (1 << BOARD_LED3)\n\n/* LED state encoding for CONFIG_ARCH_LEDS */\n\n#define LED_STARTED        0 /* NuttX has been started   OFF    OFF   OFF  */\n#define LED_HEAPALLOCATE   1 /* Heap has been allocated  OFF    OFF   ON   */\n#define LED_IRQSENABLED    2 /* Interrupts enabled       OFF    ON    OFF  */\n#define LED_STACKCREATED   3 /* Idle stack created       OFF    ON    ON   */\n#define LED_INIRQ          4 /* In an interrupt          N/C    N/C   GLOW */\n#define LED_SIGNAL         5 /* In a signal handler      N/C    GLOW  N/C  */\n#define LED_ASSERTION      6 /* An assertion failed      GLOW   N/C   GLOW */\n#define LED_PANIC          7 /* The system has crashed   Blink  OFF   N/C  */\n#define LED_IDLE           8 /* MCU is in sleep mode     ON     OFF   OFF  */\n\n/* Alternate function pin selections ****************************************/\n/* USART1 (Nucleo Virtual Console): PE5=TX (AF7), PE6=RX (AF7)\n * Connected to the on-board ST-Link to provide a Virtual COM Port.\n */\n\n#define GPIO_USART1_TX   GPIO_USART1_TX_1\n#define GPIO_USART1_RX   GPIO_USART1_RX_1\n\n/****************************************************************************\n * Public Data\n ****************************************************************************/\n\n#ifndef __ASSEMBLY__\n\n#undef EXTERN\n#if defined(__cplusplus)\n#define EXTERN extern \"C\"\nextern \"C\"\n{\n#else\n#define EXTERN extern\n#endif\n\n/****************************************************************************\n * Public Function Prototypes\n ****************************************************************************/\n\n/****************************************************************************\n * Name: stm32_board_initialize\n *\n * Description:\n *   All STM32N6 architectures must provide the following entry point.\n *   This entry point is called early in the initialization -- after all\n *   memory has been configured and mapped but before any devices\n *   have been initialized.\n *\n ****************************************************************************/\n\nvoid stm32_board_initialize(void);\n\n#undef EXTERN\n#if defined(__cplusplus)\n}\n#endif\n\n#endif /* __ASSEMBLY__ */\n#endif /* __VENDOR_OPENVELA_BOARDS_CONTEST2026_224_BOARD_INCLUDE_BOARD_H */\n","numLines":165,"startLine":1,"totalLines":165}},"sourceToolAssistantUUID":"59307859-d595-4845-8d9e-2476840a3558","userType":"external","entrypoint":"claude-vscode","cwd":"/home/warner/openvela","sessionId":"2d4ac909-674d-4c60-84e6-9f60f265e8c3","version":"2.1.237","gitBranch":"HEAD","slug":"synthetic-wandering-llama"}
