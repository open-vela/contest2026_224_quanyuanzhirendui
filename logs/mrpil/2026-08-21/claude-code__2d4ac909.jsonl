 to a common location for all N6 boards?\n38\t\n39\t    // Enable PWR, BSEC and SYSCFG clocks.\n40\t    LL_AHB4_GRP1_EnableClock(LL_AHB4_GRP1_PERIPH_PWR);\n41\t    LL_APB4_GRP2_EnableClock(LL_APB4_GRP2_PERIPH_BSEC);\n42\t    LL_APB4_GRP2_EnableClock(LL_APB4_GRP2_PERIPH_SYSCFG);\n43\t\n44\t    // Program high speed IO optimization fuses if they aren't already set.\n45\t    uint32_t fuse;\n46\t    BSEC_HandleTypeDef hbsec = { .Instance = BSEC };\n47\t    const uint32_t mask = BSEC_HWS_HSLV_VDDIO3;\n48\t    if (HAL_BSEC_OTP_Read(&hbsec, BSEC_HW_CONFIG_ID, &fuse) != HAL_OK) {\n49\t        fuse = 0;\n50\t    } else if ((fuse & mask) != mask) {\n51\t        // Program the fuse, and read back the set value.\n52\t        if (HAL_BSEC_OTP_Program(&hbsec, BSEC_HW_CONFIG_ID, fuse | mask, HAL_BSEC_NORMAL_PROG) != HAL_OK) {\n53\t            fuse = 0;\n54\t        } else if (HAL_BSEC_OTP_Read(&hbsec, BSEC_HW_CONFIG_ID, &fuse) != HAL_OK) {\n55\t            fuse = 0;\n56\t        }\n57\t    }\n58\t\n59\t    // Enable Vdd ADC, needed for the ADC to work.\n60\t    LL_PWR_EnableVddADC();\n61\t\n62\t    // Configure VDDIO2.\n63\t    LL_PWR_EnableVddIO2();\n64\t    LL_PWR_SetVddIO2VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_3V3);\n65\t    SYSCFG->VDDIO2CCCR |= SYSCFG_VDDIO2CCCR_EN; // enable IO compensation\n66\t\n67\t    // Configure VDDIO3.  Only enable 1.8V mode if the fuse is set.\n68\t    LL_PWR_EnableVddIO3();\n69\t    if (fuse & BSEC_HWS_HSLV_VDDIO3) {\n70\t        LL_PWR_SetVddIO3VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_1V8);\n71\t    }\n72\t    SYSCFG->VDDIO3CCCR |= SYSCFG_VDDIO3CCCR_EN; // enable IO compensation\n73\t\n74\t    // Configure VDDIO4.\n75\t    LL_PWR_EnableVddIO4();\n76\t    LL_PWR_SetVddIO4VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_3V3);\n77\t    SYSCFG->VDDIO4CCCR |= SYSCFG_VDDIO4CCCR_EN; // enable IO compensation\n78\t\n79\t    // Enable VDD for ADC and USB.\n80\t    LL_PWR_EnableVddADC();\n81\t    LL_PWR_EnableVddUSB();\n82\t}\n83\t\n84\tvoid mboot_board_early_init(void) {\n85\t    board_config_vdd();\n86\t\n87\t    /* Match CubeIDE FSBL: configure SMPS supply + voltage scaling */\n88\t    HAL_PWREx_ConfigSupply(PWR_SMPS_SUPPLY);\n89\t    HAL_PWREx_ControlVoltageScaling(PWR_REGULATOR_VOLTAGE_SCALE0);\n90\t\n91\t    xspi_init();\n92\t\n93\t    /*\n94\t     * Pre-configure PLL2 / PLL4 and IC17 / IC18 for DCMIPP + CSI.\n95\t     * In the CubeIDE project these are set up in the FSBL; mboot is\n96\t     * the MicroPython equivalent.  Raw register writes with DSB\n97\t     * barriers — the STM32N6 RIF may silently drop writes made\n98\t     * through LL / HAL helpers on locked peripherals.\n99\t     *\n100\t     * PLL2: HSE 48 MHz, /2, *50, P1=1 → VCO = 1200 MHz\n101\t     * IC17: PLL2 / 3 = 400 MHz  (DCMIPP kernel)\n102\t     * PLL4: HSE 48 MHz, /3, *25, P1=1 → VCO = 400 MHz\n103\t     * IC18: PLL4 / 20 = 20 MHz   (CSI PHY)\n104\t     */\n105\t    if (!(RCC->SR & RCC_SR_PLL2RDY)) {\n106\t        RCC->PLL2CFGR1 = (2U << RCC_PLL2CFGR1_PLL2SEL_Pos)\n107\t            | (2U << RCC_PLL2CFGR1_PLL2DIVM_Pos)\n108\t            | (50U << RCC_PLL2CFGR1_PLL2DIVN_Pos);\n109\t        RCC->PLL2CFGR2 = 0;\n110\t        RCC->PLL2CFGR3 = (1U << RCC_PLL2CFGR3_PLL2PDIV1_Pos)\n111\t            | (1U << RCC_PLL2CFGR3_PLL2PDIV2_Pos)\n112\t            | RCC_PLL2CFGR3_PLL2PDIVEN;\n113\t        __DSB();\n114\t        RCC->CSR |= RCC_CSR_PLL2ONS;\n115\t        __DSB();\n116\t        while (!(RCC->SR & RCC_SR_PLL2RDY)) {\n117\t        }\n118\t    }\n119\t\n120\t    if (!(RCC->SR & RCC_SR_PLL4RDY)) {\n121\t        RCC->PLL4CFGR1 = (2U << RCC_PLL4CFGR1_PLL4SEL_Pos)\n122\t            | (3U << RCC_PLL4CFGR1_PLL4DIVM_Pos)\n123\t            | (25U << RCC_PLL4CFGR1_PLL4DIVN_Pos);\n124\t        RCC->PLL4CFGR2 = 0;\n125\t        RCC->PLL4CFGR3 = (1U << RCC_PLL4CFGR3_PLL4PDIV1_Pos)\n126\t            | (1U << RCC_PLL4CFGR3_PLL4PDIV2_Pos)\n127\t            | RCC_PLL4CFGR3_PLL4PDIVEN;\n128\t        __DSB();\n129\t        RCC->CSR |= RCC_CSR_PLL4ONS;\n130\t        __DSB();\n131\t        while (!(RCC->SR & RCC_SR_PLL4RDY)) {\n132\t        }\n133\t    }\n134\t\n135\t    /* IC17: DCMIPP kernel clock = PLL2 / 3 = 400 MHz */\n136\t    MODIFY_REG(RCC->IC17CFGR,\n137\t        RCC_IC17CFGR_IC17SEL | RCC_IC17CFGR_IC17INT,\n138\t        RCC_ICCLKSOURCE_PLL2 | ((3U - 1U) << RCC_IC17CFGR_IC17INT_Pos));\n139\t    LL_RCC_IC17_Enable();\n140\t\n141\t    /* IC18: CSI PHY clock = PLL4 / 20 = 20 MHz */\n142\t    MODIFY_REG(RCC->IC18CFGR,\n143\t        RCC_IC18CFGR_IC18SEL | RCC_IC18CFGR_IC18INT,\n144\t        RCC_ICCLKSOURCE_PLL4 | ((20U - 1U) << RCC_IC18CFGR_IC18INT_Pos));\n145\t    LL_RCC_IC18_Enable();\n146\t\n147\t    /* Route DCMIPP kernel clock to IC17 */\n148\t    MODIFY_REG(RCC->CCIPR1, RCC_CCIPR1_DCMIPPSEL, LL_RCC_DCMIPP_CLKSOURCE_IC17);\n149\t\n150\t    __DSB();\n151\t    __ISB();\n152\t}\n153\t\n154\tvoid board_early_init(void) {\n155\t    #if !MICROPY_HW_RUNS_FROM_EXT_FLASH\n156\t    // Firmware runs directly from SRAM, so configure VDD and enable XSPI flash.\n157\t    board_config_vdd();\n158\t    xspi_init();\n159\t    #else\n160\t    /*\n161\t     * When running from XSPI flash (USE_MBOOT=1), mboot already configured\n162\t     * VDDIO.  Re-enable the I/O supplies here in case the main firmware's\n163\t     * startup path reset or reconfigured them.  This is critical for the\n164\t     * camera control pins on GPIOG (VDDIO4, 3.3V).\n165\t     */\n166\t    LL_AHB4_GRP1_EnableClock(LL_AHB4_GRP1_PERIPH_PWR);\n167\t    LL_PWR_EnableVddIO4();\n168\t    LL_PWR_EnableVddIO3();\n169\t    LL_PWR_EnableVddIO2();\n170\t    #endif\n171\t\n172\t    /*\n173\t     * Pre-configure PLL2 / PLL4 and IC17 / IC18 for DCMIPP + CSI.\n174\t     * These clocks are needed by the MIPI camera interface and must be\n175\t     * ready before HAL_DCMIPP_Init is called (it selects IC17←PLL2\n176\t     * and IC18←PLL4 via PeriphCLKConfig).\n177\t     *\n178\t     * This matches the CubeIDE FSBL approach — PLLs are set up at boot,\n179\t     * not lazily in the camera driver.  Raw register writes with DSB\n180\t     * barriers are used because the STM32N6 RIF may silently reject\n181\t     * writes made through LL / HAL helper macros.\n182\t     *\n183\t     * Clock targets:\n184\t     *   PLL2: HSE 48MHz, /2, *50, P1=1 → VCO = 1200 MHz\n185\t     *   IC17: PLL2 / 3 = 400 MHz (DCMIPP kernel, max 400 MHz)\n186\t     *   PLL4: HSE 48MHz, /3, *25, P1=1 → VCO = 400 MHz\n187\t     *   IC18: PLL4 / 20 = 20 MHz (CSI PHY)\n188\t     */\n189\t    if (!(RCC->SR & RCC_SR_PLL2RDY)) {\n190\t        RCC->PLL2CFGR1 = (2U << RCC_PLL2CFGR1_PLL2SEL_Pos)\n191\t            | (2U << RCC_PLL2CFGR1_PLL2DIVM_Pos)\n192\t            | (50U << RCC_PLL2CFGR1_PLL2DIVN_Pos);\n193\t        RCC->PLL2CFGR2 = 0;\n194\t        RCC->PLL2CFGR3 = (1U << RCC_PLL2CFGR3_PLL2PDIV1_Pos)\n195\t            | (1U << RCC_PLL2CFGR3_PLL2PDIV2_Pos)\n196\t            | RCC_PLL2CFGR3_PLL2PDIVEN;\n197\t        __DSB();\n198\t        RCC->CSR |= RCC_CSR_PLL2ONS;  /* enable PLL2 */\n199\t        __DSB();\n200\t        while (!(RCC->SR & RCC_SR_PLL2RDY)) {\n201\t        }\n202\t    }\n203\t\n204\t    if (!(RCC->SR & RCC_SR_PLL4RDY)) {\n205\t        RCC->PLL4CFGR1 = (2U << RCC_PLL4CFGR1_PLL4SEL_Pos)\n206\t            | (3U << RCC_PLL4CFGR1_PLL4DIVM_Pos)\n207\t            | (25U << RCC_PLL4CFGR1_PLL4DIVN_Pos);\n208\t        RCC->PLL4CFGR2 = 0;\n209\t        RCC->PLL4CFGR3 = (1U << RCC_PLL4CFGR3_PLL4PDIV1_Pos)\n210\t            | (1U << RCC_PLL4CFGR3_PLL4PDIV2_Pos)\n211\t            | RCC_PLL4CFGR3_PLL4PDIVEN;\n212\t        __DSB();\n213\t        RCC->CSR |= RCC_CSR_PLL4ONS;  /* enable PLL4 */\n214\t        __DSB();\n215\t        while (!(RCC->SR & RCC_SR_PLL4RDY)) {\n216\t        }\n217\t    }\n218\t\n219\t    /* IC17: DCMIPP kernel clock = PLL2 / 3 = 400 MHz */\n220\t    MODIFY_REG(RCC->IC17CFGR,\n221\t        RCC_IC17CFGR_IC17SEL | RCC_IC17CFGR_IC17INT,\n222\t        RCC_ICCLKSOURCE_PLL2 | ((3U - 1U) << RCC_IC17CFGR_IC17INT_Pos));\n223\t    LL_RCC_IC17_Enable();\n224\t\n225\t    /* IC18: CSI PHY clock = PLL4 / 20 = 20 MHz */\n226\t    MODIFY_REG(RCC->IC18CFGR,\n227\t        RCC_IC18CFGR_IC18SEL | RCC_IC18CFGR_IC18INT,\n228\t        RCC_ICCLKSOURCE_PLL4 | ((20U - 1U) << RCC_IC18CFGR_IC18INT_Pos));\n229\t    LL_RCC_IC18_Enable();\n230\t\n231\t    /* Route DCMIPP kernel clock to IC17 */\n232\t    MODIFY_REG(RCC->CCIPR1, RCC_CCIPR1_DCMIPPSEL, LL_RCC_DCMIPP_CLKSOURCE_IC17);\n233\t\n234\t    __DSB();\n235\t    __ISB();\n236\t}\n237\t\n238\tvoid board_leave_standby(void) {\n239\t    // TODO: move some of the below code to a common location for all N6 boards?\n240\t\n241\t    // Enable PWR, BSEC and SYSCFG clocks.\n242\t    LL_AHB4_GRP1_EnableClock(LL_AHB4_GRP1_PERIPH_PWR);\n243\t    LL_APB4_GRP2_EnableClock(LL_APB4_GRP2_PERIPH_BSEC);\n244\t    LL_APB4_GRP2_EnableClock(LL_APB4_GRP2_PERIPH_SYSCFG);\n245\t\n246\t    // Configure VDDIO2.\n247\t    LL_PWR_EnableVddIO2();\n248\t    LL_PWR_SetVddIO2VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_3V3);\n249\t    SYSCFG->VDDIO2CCCR |= SYSCFG_VDDIO2CCCR_EN; // enable IO compensation\n250\t\n251\t    // Configure VDDIO3 (1.8V mode selection is retained).\n252\t    LL_PWR_EnableVddIO3();\n253\t    SYSCFG->VDDIO3CCCR |= SYSCFG_VDDIO3CCCR_EN; // enable IO compensation\n254\t\n255\t    // Configure VDDIO4.\n256\t    LL_PWR_EnableVddIO4();\n257\t    LL_PWR_SetVddIO4VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_3V3);\n258\t    SYSCFG->VDDIO4CCCR |= SYSCFG_VDDIO4CCCR_EN; // enable IO compensation\n259\t\n260\t    // Enable VDD for ADC and USB.\n261\t    LL_PWR_EnableVddADC();\n262\t    LL_PWR_EnableVddUSB();\n263\t}\n264\t"}]},"uuid":"973c6586-1cb7-4e8d-873f-4c80419fde7e","timestamp":"2026-08-21T01:59:20.610Z","toolUseResult":{"type":"text","file":{"filePath":"/home/warner/openvela/atk-dnn647-micropython/ports/stm32/boards/ATK_DNN647/board.c","content":"/*\n * This file is part of the MicroPython project, http://micropython.org/\n *\n * The MIT License (MIT)\n *\n * Copyright (c) 2024-2025 Damien P. George\n *\n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n *\n * The above copyright notice and this permission notice shall be included in\n * all copies or substantial portions of the Software.\n *\n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n * THE SOFTWARE.\n */\n\n#include \"py/mphal.h\"\n#include \"boardctrl.h\"\n#include \"xspi.h\"\n\n// Values for OTP fuses for VDDIO3, to select low voltage mode (<2.5V).\n// See RM0486, Section 5, Table 18.\n#define BSEC_HW_CONFIG_ID       (124U)\n#define BSEC_HWS_HSLV_VDDIO3    (1U << 15)\n\nstatic void board_config_vdd(void) {\n    // TODO: move some of the below code to a common location for all N6 boards?\n\n    // Enable PWR, BSEC and SYSCFG clocks.\n    LL_AHB4_GRP1_EnableClock(LL_AHB4_GRP1_PERIPH_PWR);\n    LL_APB4_GRP2_EnableClock(LL_APB4_GRP2_PERIPH_BSEC);\n    LL_APB4_GRP2_EnableClock(LL_APB4_GRP2_PERIPH_SYSCFG);\n\n    // Program high speed IO optimization fuses if they aren't already set.\n    uint32_t fuse;\n    BSEC_HandleTypeDef hbsec = { .Instance = BSEC };\n    const uint32_t mask = BSEC_HWS_HSLV_VDDIO3;\n    if (HAL_BSEC_OTP_Read(&hbsec, BSEC_HW_CONFIG_ID, &fuse) != HAL_OK) {\n        fuse = 0;\n    } else if ((fuse & mask) != mask) {\n        // Program the fuse, and read back the set value.\n        if (HAL_BSEC_OTP_Program(&hbsec, BSEC_HW_CONFIG_ID, fuse | mask, HAL_BSEC_NORMAL_PROG) != HAL_OK) {\n            fuse = 0;\n        } else if (HAL_BSEC_OTP_Read(&hbsec, BSEC_HW_CONFIG_ID, &fuse) != HAL_OK) {\n            fuse = 0;\n        }\n    }\n\n    // Enable Vdd ADC, needed for the ADC to work.\n    LL_PWR_EnableVddADC();\n\n    // Configure VDDIO2.\n    LL_PWR_EnableVddIO2();\n    LL_PWR_SetVddIO2VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_3V3);\n    SYSCFG->VDDIO2CCCR |= SYSCFG_VDDIO2CCCR_EN; // enable IO compensation\n\n    // Configure VDDIO3.  Only enable 1.8V mode if the fuse is set.\n    LL_PWR_EnableVddIO3();\n    if (fuse & BSEC_HWS_HSLV_VDDIO3) {\n        LL_PWR_SetVddIO3VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_1V8);\n    }\n    SYSCFG->VDDIO3CCCR |= SYSCFG_VDDIO3CCCR_EN; // enable IO compensation\n\n    // Configure VDDIO4.\n    LL_PWR_EnableVddIO4();\n    LL_PWR_SetVddIO4VoltageRange(LL_PWR_VDDIO_VOLTAGE_RANGE_3V3);\n    SYSCFG->VDDIO4CCCR |= SYSCFG_VDDIO4CCCR_EN; // enable IO compensation\n\n    // Enable VDD for ADC and USB.\n    LL_PWR_EnableVddADC();\n    LL_PWR_EnableVddUSB();\n}\n\nvoid mboot_board_early_init(void) {\n    board_config_vdd();\n\n    /* Match CubeIDE FSBL: configure SMPS supply + voltage scaling */\n    HAL_PWREx_ConfigSupply(PWR_SMPS_SUPPLY);\n    HAL_PWREx_ControlVoltageScaling(PWR_REGULATOR_VOLTAGE_SCALE0);\n\n    xspi_init();\n\n    /*\n     * Pre-configure PLL2 / PLL4 and IC17 / IC18 for DCMIPP + CSI.\n     * In the CubeIDE project these are set up in the FSBL; mboot is\n     * the MicroPython equivalent.  Raw register writes with DSB\n     * barriers — the STM32N6 RIF may silently drop writes made\n     * through LL / HAL helpers on locked peripherals.\n     *\n     * PLL2: HSE 48 MHz, /2, *50, P1=1 → VCO = 1200 MHz\n     * IC17: PLL2 / 3 = 400 MHz  (DCMIPP kernel)\n     * PLL4: HSE 48 MHz, /3, *25, P1=1 → VCO = 400 MHz\n     * IC18: PLL4 / 20 = 20 MHz   (CSI PHY)\n     */\n    if (!(RCC->SR & RCC_SR_PLL2RDY)) {\n        RCC->PLL2CFGR1 = (2U << RCC_PLL2CFGR1_PLL2SEL_Pos)\n            | (2U << RCC_PLL2CFGR1_PLL2DIVM_Pos)\n            | (50U << RCC_PLL2CFGR1_PLL2DIVN_Pos);\n        RCC->PLL2CFGR2 = 0;\n        RCC->PLL2CFGR3 = (1U << RCC_PLL2CFGR3_PLL2PDIV1_Pos)\n            | (1U << RCC_PLL2CFGR3_PLL2PDIV2_Pos)\n            | RCC_PLL2CFGR3_PLL2PDIVEN;\n        __DSB();\n        RCC->CSR |= RCC_CSR_PLL2ONS;\n        __DSB();\n        while (!(RCC->SR & RCC_SR_PLL2RDY)) {\n        }\n    }\n\n    if (!(RCC->SR & RCC_SR_PLL4RDY)) {\n        RCC->PLL4CFGR1 = (2U << RCC_PLL4CFGR1_PLL4SEL_Pos)\n            | (3U << RCC_PLL4CFGR1_PLL4DIVM_Pos)\n            | (25U << RCC_PLL4CFGR1_PLL4DIVN_Pos);\n        RCC->PLL4CFGR2 = 0;\n        RCC->PLL4CFGR3 = (1U << RCC_PLL4CFGR3_PLL4PDIV1_Pos)\n            | (1U << RCC_PLL4CFGR3_PLL4PDIV2_Pos)\n            | RCC_PLL4CFGR3_PLL4PDIVEN;\n        __DSB();\n        RCC->CSR |= RCC_CSR_PLL4ONS;\n        __DSB();\n        while (!(RCC->SR & RCC_SR_PLL4RDY)) {\n        }\n    }\n\n    /* IC17: DCMIPP kernel clock = PLL2 / 3 = 400 MHz */\n    MODIFY_REG(RCC->IC17CFGR,\n        RCC_IC17CFGR_IC17SEL | RCC_IC17CFGR_IC17INT,\n        RCC_ICCLKSOURCE_PLL2 | ((3U - 1U) << RCC_IC17CFGR_IC17INT_Pos));\n    LL_RCC_IC17_Enable();\n\n    /* IC18: CSI PHY clock = PLL4 / 20 = 20 MHz */\n    MODIFY_REG(RCC->IC18CFGR,\n        RCC_IC18CFGR_IC18SEL | RCC_IC18CFGR_IC18INT,\n        RCC_ICCLKSOURCE_PLL4 | ((20U - 1U) << RCC_IC18CFGR_IC18INT_Pos));\n    LL_RCC_IC18_Enable();\n\n    /* Route DCMIPP kernel clock to IC17 */\n    MODIFY_REG(RCC->CCIPR1, RCC_CCIPR1_DCMIPPSEL, LL_RCC_DCMIPP_CLKSOURCE_IC17);\n\n    __DSB();\n    __ISB();\n}\n\nvoid board_early_init(void) {\n    #if !MICROPY_HW_RUNS_FROM_EXT_FLASH\n    // Firmware runs directly from SRAM, so configure VDD and enable XSPI flash.\n    board_config_vdd();\n    xspi_init();\n    #else\n    /*\n     * When running from XSPI flash (USE_MBOOT=1),