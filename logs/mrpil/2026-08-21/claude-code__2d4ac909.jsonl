4\t/****************************************************************************\n35\t * Included Files\n36\t ****************************************************************************/\n37\t\n38\t#include <nuttx/config.h>\n39\t#include <stdint.h>\n40\t#include <string.h>\n41\t\n42\t#include \"arm_internal.h\"\n43\t#include \"stm32n6_xspi.h\"\n44\t#include \"hardware/stm32n6xxx_memorymap.h\"\n45\t#include \"hardware/stm32n6xxx_rcc.h\"\n46\t\n47\t/****************************************************************************\n48\t * Pre-processor Definitions\n49\t ****************************************************************************/\n50\t\n51\t/* Application entry point in external flash */\n52\t\n53\t#define APP_ENTRY_ADDR    0x70080000\n54\t\n55\t/* BSEC OTP fuse for VDDIO3 high-speed IO optimization */\n56\t\n57\t#define BSEC_HW_CONFIG_ID     124\n58\t#define BSEC_HWS_HSLV_VDDIO3  (1 << 15)\n59\t\n60\t/* ARM Cortex-M55 System Control Block registers */\n61\t\n62\t#define SCB_VTOR  (*(volatile uint32_t *)0xE000ED08UL)\n63\t\n64\t/* PWR register addresses (simplified for FSBL) */\n65\t\n66\t#define STM32_RCC_AHB4ENR_OFFSET   0x00   /* AHB4 enable register offset */\n67\t#define STM32_RCC_APB4ENR2_OFFSET  0x04   /* APB4 enable register 2 offset */\n68\t\n69\t/* RCC AHB4/APB4 enable bits */\n70\t\n71\t#define RCC_AHB4ENR_PWREN_Pos      31\n72\t#define RCC_AHB4ENR_PWREN          (1 << 31)\n73\t\n74\t#define RCC_APB4HEN2_BSECEN_Pos    0\n75\t#define RCC_APB4HEN2_BSECEN        (1 << 0)\n76\t#define RCC_APB4HEN2_SYSCFGEN_Pos  1\n77\t#define RCC_APB4HEN2_SYSCFGEN      (1 << 1)\n78\t\n79\t/* PWR registers for VDDIO3 configuration */\n80\t\n81\t#define PWR_BASE            0x46020800UL\n82\t#define PWR_OFFSET_VDDIO3CR  0x34  /* VDDIO3 control register offset */\n83\t\n84\t/* SYSCFG registers for IO compensation */\n85\t\n86\t#define SYSCFG_BASE         0x46020400UL\n87\t#define SYSCFG_VDDIO3CCCR_OFFSET  0x28\n88\t\n89\t/****************************************************************************\n90\t * Private Functions\n91\t ****************************************************************************/\n92\t\n93\t/* Configure VDDIO domains for XSPI flash pins */\n94\t\n95\tstatic void fsbl_config_vdd(void)\n96\t{\n97\t  /* Enable PWR, BSEC, SYSCFG clocks */\n98\t\n99\t  modifyreg32(STM32_RCC_AHB4ENR, 0, RCC_AHB4ENR_PWREN);\n100\t  modifyreg32(STM32_RCC_APB4HENR, 0, RCC_APB4HEN2_BSECEN |\n101\t                                      RCC_APB4HEN2_SYSCFGEN);\n102\t\n103\t  /* Configure VDDIO3 for 1.8V (XSPI pins PN0-PN11 are on VDDIO3)\n104\t   *\n105\t   * NOTE: The exact register layout depends on the STM32N6 variant.\n106\t   * This is a simplified version.  For production code, use the\n107\t   * STM32 HAL PWR functions.\n108\t   */\n109\t\n110\t  /* Program OTP fuse for VDDIO3 high-speed mode if not already set.\n111\t   *\n112\t   * WARNING: This is a ONE-TIME irreversible operation (burns OTP fuse).\n113\t   * Only do this once on a new board.  After that, the fuse persists.\n114\t   *\n115\t   * For initial development, we skip the fuse programming and just\n116\t   * configure VDDIO3 for 1.8V without the HSLV optimization.\n117\t   */\n118\t\n119\t  /* Enable VDDIO3 domain and set 1.8V range */\n120\t\n121\t  volatile uint32_t *pwr_vddio3cr =\n122\t    (volatile uint32_t *)(PWR_BASE + PWR_OFFSET_VDDIO3CR);\n123\t\n124\t  /* Set VDDIO3 voltage range to 1.8V (bit 0 = 0 for 1.8V, 1 for 3.3V) */\n125\t\n126\t  *pwr_vddio3cr &= ~(1 << 0);  /* 1.8V range */\n127\t\n128\t  /* Enable IO compensation for VDDIO3 */\n129\t\n130\t  volatile uint32_t *syscfg_vddio3cccr =\n131\t    (volatile uint32_t *)(SYSCFG_BASE + SYSCFG_VDDIO3CCCR_OFFSET);\n132\t\n133\t  *syscfg_vddio3cccr |= (1 << 0);  /* Enable compensation cell */\n134\t}\n135\t\n136\t/****************************************************************************\n137\t * Public Functions\n138\t ****************************************************************************/\n139\t\n140\t/****************************************************************************\n141\t * Name: fsbl_entry\n142\t *\n143\t * Description:\n144\t *   Entry point for the FSBL.  Called by the hardware boot ROM after\n145\t *   loading this code from flash offset 0 into SRAM2 at 0x34180400.\n146\t *\n147\t ****************************************************************************/\n148\t\n149\tvoid fsbl_entry(void)\n150\t{\n151\t  /* Set vector table to our location */\n152\t\n153\t  SCB_VTOR = 0x34180400;\n154\t\n155\t  /* Configure power domains for XSPI */\n156\t\n157\t  fsbl_config_vdd();\n158\t\n159\t  /* Initialize XSPI2 and enable memory-mapped flash */\n160\t\n161\t  stm32n6_xspi_initialize();\n162\t\n163\t  /* Jump to main application in external flash (XIP) */\n164\t\n165\t  /* The application's vector table is at 0x70080000:\n166\t   *   [0] = Initial stack pointer\n167\t   *   [1] = Reset handler address\n168\t   */\n169\t\n170\t  uint32_t app_sp  = *(volatile uint32_t *)(APP_ENTRY_ADDR);\n171\t  uint32_t app_pc  = *(volatile uint32_t *)(APP_ENTRY_ADDR + 4);\n172\t\n173\t  /* Set stack pointer */\n174\t\n175\t  __asm__ volatile (\"msr msp, %0\" :: \"r\" (app_sp));\n176\t\n177\t  /* Jump to application */\n178\t\n179\t  void (*app_reset)(void) = (void (*)(void))app_pc;\n180\t  app_reset();\n181\t\n182\t  /* Should never reach here */\n183\t\n184\t  for (;;);\n185\t}\n186\t\n187\t/****************************************************************************\n188\t * Name: main\n189\t *\n190\t * Description:\n191\t *   NuttX entry point.  Simply calls fsbl_entry().\n192\t *\n193\t ****************************************************************************/\n194\t\n195\tint main(int argc, char *argv[])\n196\t{\n197\t  fsbl_entry();\n198\t  return 0;  /* Never reached */\n199\t}\n200\t"}]},"uuid":"1da9cd4c-076f-4ece-bc22-781f51ad9ccb","timestamp":"2026-08-21T15:06:34.751Z","toolUseResult":{"type":"text","file":{"filePath":"/home/warner/openvela/vendor/openvela/boards/contest2026_224_board/src/stm32_fsbl.c","content":"/****************************************************************************\n * vendor/openvela/boards/contest2026_224_board/src/stm32_fsbl.c\n *\n * SPDX-License-Identifier: Apache-2.0\n *\n * Licensed to the Apache Software Foundation (ASF) under one or more\n * contributor license agreements.  See the NOTICE file distributed with\n * this work for additional information regarding copyright ownership.\n * The ASF licenses this file to you under the Apache License, Version 2.0\n * (the \"License\"); you may not use this file except in compliance with\n * the License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS,\n * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n * See the License for the specific language governing permissions and\n * limitations under the License.\n *\n ****************************************************************************/\n\n/****************************************************************************\n * FSBL (First Stage Boot Loader) for NUCLEO-N657X0-Q.\n *\n * This runs from SRAM2 after the hardware boot ROM loads it from\n * external flash offset 0.  Its job:\n *   1. Configure VDDIO3 (1.8V) for XSPI pins\n *   2. Initialize XSPI2 and switch flash to Octal DTR mode\n *   3. Enable memory-mapped mode (XIP)\n *   4. Jump to the main NuttX application at 0x70080000\n ****************************************************************************/\n\n/****************************************************************************\n * Included Files\n ****************************************************************************/\n\n#include <nuttx/config.h>\n#include <stdint.h>\n#include <string.h>\n\n#include \"arm_internal.h\"\n#include \"stm32n6_xspi.h\"\n#include \"hardware/stm32n6xxx_memorymap.h\"\n#include \"hardware/stm32n6xxx_rcc.h\"\n\n/****************************************************************************\n * Pre-processor Definitions\n ****************************************************************************/\n\n/* Application entry point in external flash */\n\n#define APP_ENTRY_ADDR    0x70080000\n\n/* BSEC OTP fuse for VDDIO3 high-speed IO optimization */\n\n#define BSEC_HW_CONFIG_ID     124\n#define BSEC_HWS_HSLV_VDDIO3  (1 << 15)\n\n/* ARM Cortex-M55 System Control Block registers */\n\n#define SCB_VTOR  (*(volatile uint32_t *)0xE000ED08UL)\n\n/* PWR register addresses (simplified for FSBL) */\n\n#define STM32_RCC_AHB4ENR_OFFSET   0x00   /* AHB4 enable register offset */\n#define STM32_RCC_APB4ENR2_OFFSET  0x04   /* APB4 enable register 2 offset */\n\n/* RCC AHB4/APB4 enable bits */\n\n#define RCC_AHB4ENR_PWREN_Pos      31\n#define RCC_AHB4ENR_PWREN          (1 << 31)\n\n#define RCC_APB4HEN2_BSECEN_Pos    0\n#define RCC_APB4HEN2_BSECEN        (1 << 0)\n#define RCC_APB4HEN2_SYSCFGEN_Pos  1\n#define RCC_APB4HEN2_SYSCFGEN      (1 << 1)\n\n/* PWR registers for VDDIO3 configuration */\n\n#define PWR_BASE            0x46020800UL\n#define PWR_OFFSET_VDDIO3CR  0x34  /* VDDIO3 control register offset */\n\n/* SYSCFG registers for IO compensation */\n\n#define SYSCFG_BASE         0x46020400UL\n#define SYSCFG_VDDIO3CCCR_OFFSET  0x28\n\n/****************************************************************************\n * Private Functions\n ****************************************************************************/\n\n/* Configure VDDIO domains for XSPI flash pins */\n\nstatic void fsbl_config_vdd(void)\n{\n  /* Enable PWR, BSEC, SYSCFG clocks */\n\n  modifyreg32(STM32_RCC_AHB4ENR, 0, RCC_AHB4ENR_PWREN);\n  modifyreg32(STM32_RCC_APB4HENR, 0, RCC_APB4HEN2_BSECEN |\n                                      RCC_APB4HEN2_SYSCFGEN);\n\n  /* Configure VDDIO3 for 1.8V (XSPI pins PN0-PN11 are on VDDIO3)\n   *\n   * NOTE: The exact register layout depends on the STM32N6 variant.\n   * This is a simplified version.  For production code, use the\n   * STM32 HAL PWR functions.\n   */\n\n  /* Program OTP fuse for VDDIO3 high-speed mode if not already set.\n   *\n   * WARNING: This is a ONE-TIME irreversible operation (burns OTP fuse).\n   * Only do this once on a new board.  After that, the fuse persists.\n   *\n   * For initial development, we skip the fuse programming and just\n   * configure VDDIO3 for 1.8V without the HSLV optimization.\n   */\n\n  /* Enable VDDIO3 domain and set 1.8V range */\n\n  volatile uint32_t *pwr_vddio3cr =\n    (volatile uint32_t *)(PWR_BASE + PWR_OFFSET_VDDIO3CR);\n\n  /* Set VDDIO3 voltage range to 1.8V (bit 0 = 0 for 1.8V, 1 for 3.3V) */\n\n  *pwr_vddio3cr &= ~(1 << 0);  /* 1.8V range */\n\n  /* Enable IO compensation for VDDIO3 */\n\n  volatile uint32_t *syscfg_vddio3cccr =\n    (volatile uint32_t *)(SYSCFG_BASE + SYSCFG_VDDIO3CCCR_OFFSET);\n\n  *syscfg_vddio3cccr |= (1 << 0);  /* Enable compensation cell */\n}\n\n/****************************************************************************\n * Public Functions\n ****************************************************************************/\n\n/****************************************************************************\n * Name: fsbl_entry\n *\n * Description:\n *   Entry point for the FSBL.  Called by the hardware boot ROM after\n *   loading this code from flash offset 0 into SRAM2 at 0x34180400.\n *\n ****************************************************************************/\n\nvoid fsbl_entry(void)\n{\n  /* Set vector table to our location */\n\n  SCB_VTOR = 0x34180400;\n\n  /* Configure power domains for XSPI */\n\n  fsbl_config_vdd();\n\n  /* Initialize XSPI2 and enable memory-mapped flash */\n\n  stm32n6_xspi_initialize();\n\n  /* Jump to main application in external flash (XIP) */\n\n  /* The application's vector table is at 0x70080000:\n   *   [0] = Initial stack pointer\n   *   [1] = Reset handler address\n   */\n\n  uint32_t app_sp  = *(volatile uint32_t *)(APP_ENTRY_ADDR);\n  uint32_t app_pc  = *(volatile uint32_t *)(APP_ENTRY_ADDR + 4);\n\n  /* Set stack pointer */\n\n  __asm__ volatile (\"msr msp, %0\" :: \"r\" (app_sp));\n\n  /* Jump to application */\n\n  void (*app_reset)(void) = (void (*)(void))app_pc;\n  app_reset();\n\n  /* Should never reach here */\n\n  for (;;);\n}\n\n/****************************************************************************\n * Name: main\n *\n * Description:\n *   NuttX entry point.  Simply calls fsbl_entry().\n *\n ****************************************************************************/\n\nint main(int argc, char *argv[])\n{\n  fsbl_entry();\n  return 0;  /* Never reached */\n}\n","numLines":200,"startLine":1,"totalLines":200}},"sourceToolAssistantUUID":"0420a0ef-bdcd-4be0-9d0b-03474fed5ad3","userType":"external","entrypoint":"claude-vscode","cwd":"/home/warner/openvela","sessionId":"2d4ac909-674d-4c60-84e6-9f60f265e8c3","version":"2.1.237","gitBranch":"HEAD","slug":"synthetic-wandering-llama"}
