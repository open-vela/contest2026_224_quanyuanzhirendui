*\n43\t * Private Data\n44\t ****************************************************************************/\n45\t\n46\t/* This array maps an LED number to GPIO pin configuration and is indexed by\n47\t * BOARD_LED_<color>\n48\t */\n49\t\n50\tstatic const uint32_t g_ledcfg[BOARD_NLEDS] =\n51\t{\n52\t  GPIO_LD5,\n53\t  GPIO_LD6,\n54\t  GPIO_LD7,\n55\t};\n56\t\n57\t/****************************************************************************\n58\t * Public Functions\n59\t ****************************************************************************/\n60\t\n61\t/****************************************************************************\n62\t * Name: board_userled_initialize\n63\t *\n64\t * Description:\n65\t *   If CONFIG_ARCH_LEDS is defined, then NuttX will control the on-board\n66\t *   LEDs.  If CONFIG_ARCH_LEDS is not defined, then the\n67\t *   board_userled_initialize() is available to initialize the LEDs from user\n68\t *   application logic.\n69\t *\n70\t ****************************************************************************/\n71\t\n72\tuint32_t board_userled_initialize(void)\n73\t{\n74\t  int i;\n75\t\n76\t  /* Configure LD5, LD6, and LD7 GPIOs for output */\n77\t\n78\t  for (i = 0; i < nitems(g_ledcfg); i++)\n79\t    {\n80\t      stm32_configgpio(g_ledcfg[i]);\n81\t    }\n82\t\n83\t  return BOARD_NLEDS;\n84\t}\n85\t\n86\t/****************************************************************************\n87\t * Name: board_userled\n88\t *\n89\t * Description:\n90\t *   If CONFIG_ARCH_LEDS is defined, then NuttX will control the on-board\n91\t *   LEDs.  If CONFIG_ARCH_LEDS is not defined, then the board_userled() is\n92\t *   available to control the LEDs from user application logic.\n93\t *\n94\t ****************************************************************************/\n95\t\n96\tvoid board_userled(int led, bool ledon)\n97\t{\n98\t  if ((unsigned)led < nitems(g_ledcfg))\n99\t    {\n100\t      /* Active Low */\n101\t\n102\t      stm32_gpiowrite(g_ledcfg[led], !ledon);\n103\t    }\n104\t}\n105\t\n106\t/****************************************************************************\n107\t * Name: board_userled_all\n108\t *\n109\t * Description:\n110\t *   If CONFIG_ARCH_LEDS is defined, then NuttX will control the on-board\n111\t *   LEDs.  If CONFIG_ARCH_LEDS is not defined, then the board_userled_all()\n112\t *   is available to control the LED from user application logic.\n113\t *\n114\t ****************************************************************************/\n115\t\n116\tvoid board_userled_all(uint32_t ledset)\n117\t{\n118\t  int i;\n119\t\n120\t  /* Configure LD5, LD6, and LD7 GPIOs.  Active Low: pin LOW = LED on. */\n121\t\n122\t  for (i = 0; i < nitems(g_ledcfg); i++)\n123\t    {\n124\t      stm32_gpiowrite(g_ledcfg[i], !(ledset & (1 << i)));\n125\t    }\n126\t}\n127\t\n128\t#endif /* !CONFIG_ARCH_LEDS */\n129\t"}]},"uuid":"516fad4a-3f07-49ca-8510-fe2a4c87cac9","timestamp":"2026-08-21T03:01:56.253Z","toolUseResult":{"type":"text","file":{"filePath":"/home/warner/openvela/nuttx/boards/arm/stm32n6/nucleo-n657x0-q/src/stm32_userleds.c","content":"/****************************************************************************\n * boards/arm/stm32n6/nucleo-n657x0-q/src/stm32_userleds.c\n *\n * SPDX-License-Identifier: Apache-2.0\n *\n * Licensed to the Apache Software Foundation (ASF) under one or more\n * contributor license agreements.  See the NOTICE file distributed with\n * this work for additional information regarding copyright ownership.  The\n * ASF licenses this file to you under the Apache License, Version 2.0 (the\n * \"License\"); you may not use this file except in compliance with the\n * License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT\n * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the\n * License for the specific language governing permissions and limitations\n * under the License.\n *\n ****************************************************************************/\n\n/****************************************************************************\n * Included Files\n ****************************************************************************/\n\n#include <nuttx/config.h>\n\n#include <stdbool.h>\n#include <debug.h>\n\n#include <sys/param.h>\n\n#include <nuttx/board.h>\n#include <arch/board/board.h>\n\n#include \"stm32_gpio.h\"\n#include \"nucleo-n657x0-q.h\"\n\n#ifndef CONFIG_ARCH_LEDS\n\n/****************************************************************************\n * Private Data\n ****************************************************************************/\n\n/* This array maps an LED number to GPIO pin configuration and is indexed by\n * BOARD_LED_<color>\n */\n\nstatic const uint32_t g_ledcfg[BOARD_NLEDS] =\n{\n  GPIO_LD5,\n  GPIO_LD6,\n  GPIO_LD7,\n};\n\n/****************************************************************************\n * Public Functions\n ****************************************************************************/\n\n/****************************************************************************\n * Name: board_userled_initialize\n *\n * Description:\n *   If CONFIG_ARCH_LEDS is defined, then NuttX will control the on-board\n *   LEDs.  If CONFIG_ARCH_LEDS is not defined, then the\n *   board_userled_initialize() is available to initialize the LEDs from user\n *   application logic.\n *\n ****************************************************************************/\n\nuint32_t board_userled_initialize(void)\n{\n  int i;\n\n  /* Configure LD5, LD6, and LD7 GPIOs for output */\n\n  for (i = 0; i < nitems(g_ledcfg); i++)\n    {\n      stm32_configgpio(g_ledcfg[i]);\n    }\n\n  return BOARD_NLEDS;\n}\n\n/****************************************************************************\n * Name: board_userled\n *\n * Description:\n *   If CONFIG_ARCH_LEDS is defined, then NuttX will control the on-board\n *   LEDs.  If CONFIG_ARCH_LEDS is not defined, then the board_userled() is\n *   available to control the LEDs from user application logic.\n *\n ****************************************************************************/\n\nvoid board_userled(int led, bool ledon)\n{\n  if ((unsigned)led < nitems(g_ledcfg))\n    {\n      /* Active Low */\n\n      stm32_gpiowrite(g_ledcfg[led], !ledon);\n    }\n}\n\n/****************************************************************************\n * Name: board_userled_all\n *\n * Description:\n *   If CONFIG_ARCH_LEDS is defined, then NuttX will control the on-board\n *   LEDs.  If CONFIG_ARCH_LEDS is not defined, then the board_userled_all()\n *   is available to control the LED from user application logic.\n *\n ****************************************************************************/\n\nvoid board_userled_all(uint32_t ledset)\n{\n  int i;\n\n  /* Configure LD5, LD6, and LD7 GPIOs.  Active Low: pin LOW = LED on. */\n\n  for (i = 0; i < nitems(g_ledcfg); i++)\n    {\n      stm32_gpiowrite(g_ledcfg[i], !(ledset & (1 << i)));\n    }\n}\n\n#endif /* !CONFIG_ARCH_LEDS */\n","numLines":129,"startLine":1,"totalLines":129}},"sourceToolAssistantUUID":"c619573b-071d-4a34-ac31-dbf68447c555","userType":"external","entrypoint":"claude-vscode","cwd":"/home/warner/openvela","sessionId":"2d4ac909-674d-4c60-84e6-9f60f265e8c3","version":"2.1.237","gitBranch":"HEAD"}
