tdint.h>\n\n/****************************************************************************\n * Pre-processor Definitions\n ****************************************************************************/\n\n/* XSPI2 memory-mapped base address */\n\n#define STM32N6_XSPI2_XIP_BASE  0x70000000\n\n/* Flash device parameters for MX25UM51245G (512Mbit = 64MB) */\n\n#define STM32N6_XSPI_FLASH_SIZE        (64 * 1024 * 1024)  /* 64MB */\n#define STM32N6_XSPI_FLASH_SIZE_LOG2   26                   /* 2^26 = 64MB */\n\n/****************************************************************************\n * Public Function Prototypes\n ****************************************************************************/\n\n#ifdef __cplusplus\nextern \"C\"\n{\n#endif\n\n/****************************************************************************\n * Name: stm32n6_xspi_initialize\n *\n * Description:\n *   Initialize XSPI2 peripheral, configure pins, switch flash to\n *   Octal DTR mode, and enable memory-mapped XIP access.\n *\n * Returned Value:\n *   OK on success; a negated errno on failure.\n *\n ****************************************************************************/\n\nint stm32n6_xspi_initialize(void);\n\n/****************************************************************************\n * Name: stm32n6_xspi_memory_mapped_exit\n *\n * Description:\n *   Exit memory-mapped mode to allow direct flash commands.\n *\n ****************************************************************************/\n\nvoid stm32n6_xspi_memory_mapped_exit(void);\n\n/****************************************************************************\n * Name: stm32n6_xspi_memory_mapped_enable\n *\n * Description:\n *   Re-enable memory-mapped mode after direct flash operations.\n *\n ****************************************************************************/\n\nvoid stm32n6_xspi_memory_mapped_enable(void);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /* __ARCH_ARM_SRC_STM32N6_STM32N6_XSPI_H */\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"9c853f1a-9a15-4a9d-a4c6-fd77d575accc","userType":"external","entrypoint":"claude-vscode","cwd":"/home/warner/openvela","sessionId":"2d4ac909-674d-4c60-84e6-9f60f265e8c3","version":"2.1.237","gitBranch":"HEAD","slug":"synthetic-wandering-llama"}
