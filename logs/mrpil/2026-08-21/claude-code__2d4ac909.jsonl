{"parentUuid":"3aa7d496-de20-4a2a-8131-72885b583d3c","isSidechain":false,"promptId":"3891a978-26cd-4836-9ded-b78472f3701e","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_56aa08e79ec2485998447cfd","type":"tool_result","content":"1\t/****************************************************************************\n2\t * vendor/openvela/boards/contest2026_224_board/src/stm32_fsbl.c\n3\t *\n4\t * SPDX-License-Identifier: Apache-2.0\n5\t *\n6\t * Licensed to the Apache Software Foundation (ASF) under one or more\n7\t * contributor license agreements.  See the NOTICE file distributed with\n8\t * this work for additional information regarding copyright ownership.\n9\t * The ASF licenses this file to you under the Apache License, Version 2.0\n10\t * (the \"License\"); you may not use this file except in compliance with\n11\t * the License.  You may obtain a copy of the License at\n12\t *\n13\t *   http://www.apache.org/licenses/LICENSE-2.0\n14\t *\n15\t * Unless required by applicable law or agreed to in writing, software\n16\t * distributed under the License is distributed on an \"AS IS\" BASIS,\n17\t * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n18\t * See the License for the specific language governing permissions and\n19\t * limitations under the License.\n20\t *\n21\t ****************************************************************************/\n22\t\n23\t/****************************************************************************\n24\t * FSBL (First Stage Boot Loader) for NUCLEO-N657X0-Q.\n25\t *\n26\t * This runs from SRAM2 after the hardware boot ROM loads it from\n27\t * external flash offset 0.  Its job:\n28\t *   1. Configure VDDIO3 (1.8V) for XSPI pins\n29\t *   2. Initialize XSPI2 and switch flash to Octal DTR mode\n30\t *   3. Enable memory-mapped mode (XIP)\n31\t *   4. Jump to the main NuttX application at 0x70080000\n32\t ****************************************************************************/\n33\t\n34\t/****************************************************************************\n35\t * Included Files\n36\t ****************************************************************************/\n37\t\n38\t#include <nuttx/config.h>\n39\t#include <stdint.h>\n40\t#include <string.h>\n41\t\n42\t#include \"arm_internal.h\"\n43\t#include \"arm_m_nvic.h\"\n44\t#include \"stm32n6_xspi.h\"\n45\t#include \"hardware/stm32n6xxx_memorymap.h\"\n46\t#include \"hardware/stm32n6xxx_rcc.h\"\n47\t\n48\t/****************************************************************************\n49\t * Pre-processor Definitions\n50\t ****************************************************************************/\n51\t\n52\t/* Application entry point in external flash */\n53\t\n54\t#define APP_ENTRY_ADDR    0x70080000\n55\t\n56\t/* BSEC OTP fuse for VDDIO3 high-speed IO optimization */\n57\t\n58\t#define BSEC_HW_CONFIG_ID     124\n59\t#define BSEC_HWS_HSLV_VDDIO3  (1 << 15)\n60\t\n61\t/* PWR register addresses (simplified for FSBL) */\n62\t\n63\t#define STM32_RCC_AHB4ENR_OFFSET   0x00   /* AHB4 enable register offset */\n64\t#define STM32_RCC_APB4ENR2_OFFSET  0x04   /* APB4 enable register 2 offset */\n65\t\n66\t/* RCC AHB4/APB4 enable bits */\n67\t\n68\t#define RCC_AHB4ENR_PWREN_Pos      31\n69\t#define RCC_AHB4ENR_PWREN          (1 << 31)\n70\t\n71\t#define RCC_APB4HEN2_BSECEN_Pos    0\n72\t#define RCC_APB4HEN2_BSECEN        (1 << 0)\n73\t#define RCC_APB4HEN2_SYSCFGEN_Pos  1\n74\t#define RCC_APB4HEN2_SYSCFGEN      (1 << 1)\n75\t\n76\t/* PWR registers for VDDIO3 configuration */\n77\t\n78\t#define PWR_BASE            0x46020800UL\n79\t#define PWR_OFFSET_VDDIO3CR  0x34  /* VDDIO3 control register offset */\n80\t\n81\t/* SYSCFG registers for IO compensation */\n82\t\n83\t#define SYSCFG_BASE         0x46020400UL\n84\t#define SYSCFG_VDDIO3CCCR_OFFSET  0x28\n85\t\n86\t/****************************************************************************\n87\t * Private Functions\n88\t ****************************************************************************/\n89\t\n90\t/* Configure VDDIO domains for XSPI flash pins */\n91\t\n92\tstatic void fsbl_config_vdd(void)\n93\t{\n94\t  /* Enable PWR, BSEC, SYSCFG clocks */\n95\t\n96\t  modifyreg32(STM32_RCC_AHB4ENR, 0, RCC_AHB4ENR_PWREN);\n97\t  modifyreg32(STM32_RCC_APB4HENR, 0, RCC_APB4HEN2_BSECEN |\n98\t                                      RCC_APB4HEN2_SYSCFGEN);\n99\t\n100\t  /* Configure VDDIO3 for 1.8V (XSPI pins PN0-PN11 are on VDDIO3)\n101\t   *\n102\t   * NOTE: The exact register layout depends on the STM32N6 variant.\n103\t   * This is a simplified version.  For production code, use the\n104\t   * STM32 HAL PWR functions.\n105\t   */\n106\t\n107\t  /* Program OTP fuse for VDDIO3 high-speed mode if not already set.\n108\t   *\n109\t   * WARNING: This is a ONE-TIME irreversible operation (burns OTP fuse).\n110\t   * Only do this once on a new board.  After that, the fuse persists.\n111\t   *\n112\t   * For initial development, we skip the fuse programming and just\n113\t   * configure VDDIO3 for 1.8V without the HSLV optimization.\n114\t   */\n115\t\n116\t  /* Enable VDDIO3 domain and set 1.8V range */\n117\t\n118\t  volatile uint32_t *pwr_vddio3cr =\n119\t    (volatile uint32_t *)(PWR_BASE + PWR_OFFSET_VDDIO3CR);\n120\t\n121\t  /* Set VDDIO3 voltage range to 1.8V (bit 0 = 0 for 1.8V, 1 for 3.3V) */\n122\t\n123\t  *pwr_vddio3cr &= ~(1 << 0);  /* 1.8V range */\n124\t\n125\t  /* Enable IO compensation for VDDIO3 */\n126\t\n127\t  volatile uint32_t *syscfg_vddio3cccr =\n128\t    (volatile uint32_t *)(SYSCFG_BASE + SYSCFG_VDDIO3CCCR_OFFSET);\n129\t\n130\t  *syscfg_vddio3cccr |= (1 << 0);  /* Enable compensation cell */\n131\t}\n132\t\n133\t/****************************************************************************\n134\t * Public Functions\n135\t ****************************************************************************/\n136\t\n137\t/****************************************************************************\n138\t * Name: fsbl_entry\n139\t *\n140\t * Description:\n141\t *   Entry point for the FSBL.  Called by the hardware boot ROM after\n142\t *   loading this code from flash offset 0 into SRAM2 at 0x34180400.\n143\t *\n144\t ****************************************************************************/\n145\t\n146\tvoid fsbl_entry(void)\n147\t{\n148\t  /* Set vector table to our location */\n149\t\n150\t  SCB->VTOR = 0x34180400;\n151\t\n152\t  /* Configure power domains for XSPI */\n153\t\n154\t  fsbl_config_vdd();\n155\t\n156\t  /* Initialize XSPI2 and enable memory-mapped flash */\n157\t\n158\t  stm32n6_xspi_initialize();\n159\t\n160\t  /* Jump to main application in external flash (XIP) */\n161\t\n162\t  /* The application's vector table is at 0x70080000:\n163\t   *   [0] = Initial stack pointer\n164\t   *   [1] = Reset handler address\n165\t   */\n166\t\n167\t  uint32_t app_sp  = *(volatile uint32_t *)(APP_ENTRY_ADDR);\n168\t  uint32_t app_pc  = *(volatile uint32_t *)(APP_ENTRY_ADDR + 4);\n169\t\n170\t  /* Set stack pointer */\n171\t\n172\t  __asm__ volatile (\"msr msp, %0\" :: \"r\" (app_sp));\n173\t\n174\t  /* Jump to application */\n175\t\n176\t  void (*app_reset)(void) = (void (*)(void))app_pc;\n177\t  app_reset();\n178\t\n179\t  /* Should never reach here */\n180\t\n181\t  for (;;);\n182\t}\n183\t"}]},"uuid":"12f6f450-4120-472f-9eaa-5933ec5ae3ab","timestamp":"2026-08-21T14:34:38.264Z","toolUseResult":{"type":"text","file":{"filePath":"/home/warner/openvela/vendor/openvela/boards/contest2026_224_board/src/stm32_fsbl.c","content":"/****************************************************************************\n * vendor/openvela/boards/contest2026_224_board/src/stm32_fsbl.c\n *\n * SPDX-License-Identifier: Apache-2.0\n *\n * Licensed to the Apache Software Foundation (ASF) under one or more\n * contributor license agreements.  See the NOTICE file distributed with\n * this work for additional information regarding copyright ownership.\n * The ASF licenses this file to you under the Apache License, Version 2.0\n * (the \"License\"); you may not use this file except in compliance with\n * the License.  You may obtain a copy of the License at\n *\n *   http://www.apache.org/licenses/LICENSE-2.0\n *\n * Unless required by applicable law or agreed to in writing, software\n * distributed under the License is distributed on an \"AS IS\" BASIS,\n * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n * See the License for the specific language governing permissions and\n * limitations under the License.\n *\n ****************************************************************************/\n\n/****************************************************************************\n * FSBL (First Stage Boot Loader) for NUCLEO-N657X0-Q.\n *\n * This runs from SRAM2 after the hardware boot ROM loads it from\n * external flash offset 0.  Its job:\n *   1. Configure VDDIO3 (1.8V) for XSPI pins\n *   2. Initialize XSPI2 and switch flash to Octal DTR mode\n *   3. Enable memory-mapped mode (XIP)\n *   4. Jump to the main NuttX application at 0x70080000\n ****************************************************************************/\n\n/****************************************************************************\n * Included Files\n ****************************************************************************/\n\n#include <nuttx/config.h>\n#include <stdint.h>\n#include <string.h>\n\n#include \"arm_internal.h\"\n#include \"arm_m_nvic.h\"\n#include \"stm32n6_xspi.h\"\n#include \"hardware/stm32n6xxx_memorymap.h\"\n#include \"hardware/stm32n6xxx_rcc.h\"\n\n/****************************************************************************\n * Pre-processor Definitions\n ****************************************************************************/\n\n/* Application entry point in external flash */\n\n#define APP_ENTRY_ADDR    0x70080000\n\n/* BSEC OTP fuse for VDDIO3 high-speed IO optimization */\n\n#define BSEC_HW_CONFIG_ID     124\n#define BSEC_HWS_HSLV_VDDIO3  (1 << 15)\n\n/* PWR register addresses (simplified for FSBL) */\n\n#define STM32_RCC_AHB4ENR_OFFSET   0x00   /* AHB4 enable register offset */\n#define STM32_RCC_APB4ENR2_OFFSET  0x04   /* APB4 enable register 2 offset */\n\n/* RCC AHB4/APB4 enable bits */\n\n#define RCC_AHB4ENR_PWREN_Pos      31\n#define RCC_AHB4ENR_PWREN          (1 << 31)\n\n#define RCC_APB4HEN2_BSECEN_Pos    0\n#define RCC_APB4HEN2_BSECEN        (1 << 0)\n#define RCC_APB4HEN2_SYSCFGEN_Pos  1\n#define RCC_APB4HEN2_SYSCFGEN      (1 << 1)\n\n/* PWR registers for VDDIO3 configuration */\n\n#define PWR_BASE            0x46020800UL\n#define PWR_OFFSET_VDDIO3CR  0x34  /* VDDIO3 control register offset */\n\n/* SYSCFG registers for IO compensation */\n\n#define SYSCFG_BASE         0x46020400UL\n#define SYSCFG_VDDIO3CCCR_OFFSET  0x28\n\n/****************************************************************************\n * Private Functions\n ****************************************************************************/\n\n/* Configure VDDIO domains for XSPI flash pins */\n\nstatic void fsbl_config_vdd(void)\n{\n  /* Enable PWR, BSEC, SYSCFG clocks */\n\n  modifyreg32(STM32_RCC_AHB4ENR, 0, RCC_AHB4ENR_PWREN);\n  modifyreg32(STM32_RCC_APB4HENR, 0, RCC_APB4HEN2_BSECEN |\n                                      RCC_APB4HEN2_SYSCFGEN);\n\n  /* Configure VDDIO3 for 1.8V (XSPI pins PN0-PN11 are on VDDIO3)\n   *\n   * NOTE: The exact register layout depends on the STM32N6 variant.\n   * This is a simplified version.  For production code, use the\n   * STM32 HAL PWR functions.\n   */\n\n  /* Program OTP fuse for VDDIO3 high-speed mode if not already set.\n   *\n   * WARNING: This is a ONE-TIME irreversible operation (burns OTP fuse).\n   * Only do this once on a new board.  After that, the fuse persists.\n   *\n   * For initial development, we skip the fuse programming and just\n   * configure VDDIO3 for 1.8V without the HSLV optimization.\n   */\n\n  /* Enable VDDIO3 domain and set 1.8V range */\n\n  volatile uint32_t *pwr_vddio3cr =\n    (volatile uint32_t *)(PWR_BASE + PWR_OFFSET_VDDIO3CR);\n\n  /* Set VDDIO3 voltage range to 1.8V (bit 0 = 0 for 1.8V, 1 for 3.3V) */\n\n  *pwr_vddio3cr &= ~(1 << 0);  /* 1.8V range */\n\n  /* Enable IO compensation for VDDIO3 */\n\n  volatile uint32_t *syscfg_vddio3cccr =\n    (volatile uint32_t *)(SYSCFG_BASE + SYSCFG_VDDIO3CCCR_OFFSET);\n\n  *syscfg_vddio3cccr |= (1 << 0);  /* Enable compensation cell */\n}\n\n/****************************************************************************\n * Public Functions\n ****************************************************************************/\n\n/****************************************************************************\n * Name: fsbl_entry\n *\n * Description:\n *   Entry point for the FSBL.  Called by the hardware boot ROM after\n *   loading this code from flash offset 0 into SRAM2 at 0x34180400.\n *\n ****************************************************************************/\n\nvoid fsbl_entry(void)\n{\n  /* Set vector table to our location */\n\n  SCB->VTOR = 0x34180400;\n\n  /* Configure power domains for XSPI */\n\n  fsbl_config_vdd();\n\n  /* Initialize XSPI2 and enable memory-mapped flash */\n\n  stm32n6_xspi_initialize();\n\n  /* Jump to main application in external flash (XIP) */\n\n  /* The application's vector table is at 0x70080000:\n   *   [0] = Initial stack pointer\n   *   [1] = Reset handler address\n   */\n\n  uint32_t app_sp  = *(volatile uint32_t *)(APP_ENTRY_ADDR);\n  uint32_t app_pc  = *(volatile uint32_t *)(APP_ENTRY_ADDR + 4);\n\n  /* Set stack pointer */\n\n  __asm__ volatile (\"msr msp, %0\" :: \"r\" (app_sp));\n\n  /* Jump to application */\n\n  void (*app_reset)(void) = (void (*)(void))app_pc;\n  app_reset();\n\n  /* Should never reach here */\n\n  for (;;);\n}\n","numLines":183,"startLine":1,"totalLines":183}},"sourceToolAssistantUUID":"3aa7d496-de20-4a2a-8131-72885b583d3c","userType":"external","entrypoint":"claude-vscode","cwd":"/home/warner/openvela/nuttx","sessionId