- > 0)\n    {\n      __asm__ volatile (\"nop\");\n    }\n}\n\n/* Initialize GPIOG for LED output (PG10=Red, PG0=Green, PG8=Blue) */\n\nstatic void fsbl_led_init(void)\n{\n  /* Enable GPIOG clock */\n\n  modifyreg32(STM32_RCC_AHB4ENR, 0, RCC_AHB4ENR_GPIOGEN);\n\n  /* Small delay after clock enable */\n\n  fsbl_delay(1000);\n\n  /* Configure PG10, PG0, PG8 as general purpose output (MODER = 01)\n   * MODER register: 2 bits per pin\n   *   PG10: bits [21:20] = 01\n   *   PG8:  bits [17:16] = 01\n   *   PG0:  bits [1:0]   = 01\n   */\n\n  volatile uint32_t *gpiog_moder =\n    (volatile uint32_t *)(GPIOG_BASE + GPIO_MODER_OFFSET);\n\n  *gpiog_moder &= ~((3 << (LED_RED_PIN * 2)) |\n                     (3 << (LED_GREEN_PIN * 2)) |\n                     (3 << (LED_BLUE_PIN * 2)));\n  *gpiog_moder |= ((1 << (LED_RED_PIN * 2)) |\n                    (1 << (LED_GREEN_PIN * 2)) |\n                    (1 << (LED_BLUE_PIN * 2)));\n\n  /* Set output type: push-pull (OTYPER = 0) */\n\n  volatile uint32_t *gpiog_otyper =\n    (volatile uint32_t *)(GPIOG_BASE + GPIO_OTYPER_OFFSET);\n\n  *gpiog_otyper &= ~((1 << LED_RED_PIN) |\n                      (1 << LED_GREEN_PIN) |\n                      (1 << LED_BLUE_PIN));\n\n  /* Set all LEDs OFF initially (pin HIGH = LED OFF for active-low) */\n\n  volatile uint32_t *gpiog_bsrr =\n    (volatile uint32_t *)(GPIOG_BASE + GPIO_BSRR_OFFSET);\n\n  *gpiog_bsrr = (1 << LED_RED_PIN) |\n                (1 << LED_GREEN_PIN) |\n                (1 << LED_BLUE_PIN);\n}\n\n/* Set LED state (true = ON, false = OFF) */\n\nstatic void fsbl_led_set(int pin, bool on)\n{\n  volatile uint32_t *gpiog_bsrr =\n    (volatile uint32_t *)(GPIOG_BASE + GPIO_BSRR_OFFSET);\n\n  if (on)\n    {\n      /* Active low: reset bit to turn ON */\n\n      *gpiog_bsrr = (1 << (pin + 16));\n    }\n  else\n    {\n      /* Active low: set bit to turn OFF */\n\n      *gpiog_bsrr = (1 << pin);\n    }\n}\n\n/* Blink LED n times (for visual feedback) */\n\nstatic void fsbl_led_blink(int pin, int count)\n{\n  int i;\n\n  for (i = 0; i < count; i++)\n    {\n      fsbl_led_set(pin, true);\n      fsbl_delay(500000);\n      fsbl_led_set(pin, false);\n      fsbl_delay(500000);\n    }\n}\n\n/* Configure VDDIO domains for XSPI flash pins */\n\nstatic void fsbl_config_vdd(void)\n{\n  /* Enable PWR, BSEC, SYSCFG clocks */\n\n  modifyreg32(STM32_RCC_AHB4ENR, 0, RCC_AHB4ENR_PWREN);\n  modifyreg32(STM32_RCC_APB4HENR, 0, RCC_APB4HEN2_BSECEN |\n                                      RCC_APB4HEN2_SYSCFGEN);\n\n  /* Configure VDDIO3 for 1.8V (XSPI pins PN0-PN11 are on VDDIO3)\n   *\n   * NOTE: The exact register layout depends on the STM32N6 variant.\n   * This is a simplified version.  For production code, use the\n   * STM32 HAL PWR functions.\n   */\n\n  /* Program OTP fuse for VDDIO3 high-speed mode if not already set.\n   *\n   * WARNING: This is a ONE-TIME irreversible operation (burns OTP fuse).\n   * Only do this once on a new board.  After that, the fuse persists.\n   *\n   * For initial development, we skip the fuse programming and just\n   * configure VDDIO3 for 1.8V without the HSLV optimization.\n   */\n\n  /* Enable VDDIO3 domain and set 1.8V range */\n\n  volatile uint32_t *pwr_vddio3cr =\n    (volatile uint32_t *)(PWR_BASE + PWR_OFFSET_VDDIO3CR);\n\n  /* Set VDDIO3 voltage range to 1.8V (bit 0 = 0 for 1.8V, 1 for 3.3V) */\n\n  *pwr_vddio3cr &= ~(1 << 0);  /* 1.8V range */\n\n  /* Enable IO compensation for VDDIO3 */\n\n  volatile uint32_t *syscfg_vddio3cccr =\n    (volatile uint32_t *)(SYSCFG_BASE + SYSCFG_VDDIO3CCCR_OFFSET);\n\n  *syscfg_vddio3cccr |= (1 << 0);  /* Enable compensation cell */\n}\n\n/****************************************************************************\n * Public Functions\n ****************************************************************************/\n\n/****************************************************************************\n * Name: fsbl_entry\n *\n * Description:\n *   Entry point for the FSBL.  Called by the hardware boot ROM after\n *   loading this code from flash offset 0 into SRAM2 at 0x34180400.\n *\n ****************************************************************************/\n\nvoid fsbl_entry(void)\n{\n  /* Set vector table to our location */\n\n  SCB_VTOR = 0x34180400;\n\n  /* Configure power domains for XSPI */\n\n  fsbl_config_vdd();\n\n  /* Initialize XSPI2 and enable memory-mapped flash */\n\n  stm32n6_xspi_initialize();\n\n  /* Jump to main application in external flash (XIP) */\n\n  /* The application's vector table is at 0x70080000:\n   *   [0] = Initial stack pointer\n   *   [1] = Reset handler address\n   */\n\n  uint32_t app_sp  = *(volatile uint32_t *)(APP_ENTRY_ADDR);\n  uint32_t app_pc  = *(volatile uint32_t *)(APP_ENTRY_ADDR + 4);\n\n  /* Set stack pointer */\n\n  __asm__ volatile (\"msr msp, %0\" :: \"r\" (app_sp));\n\n  /* Jump to application */\n\n  void (*app_reset)(void) = (void (*)(void))app_pc;\n  app_reset();\n\n  /* Should never reach here */\n\n  for (;;);\n}\n\n/****************************************************************************\n * Name: main\n *\n * Description:\n *   NuttX entry point.  Simply calls fsbl_entry().\n *\n ****************************************************************************/\n\nint main(int argc, char *argv[])\n{\n  fsbl_entry();\n  return 0;  /* Never reached */\n}\n","structuredPatch":[{"oldStart":266,"oldLines":14,"newStart":266,"newLines":34,"lines":[" ","   SCB_VTOR = 0x34180400;"," ","+  /* Initialize LEDs for visual feedback */","+","+  fsbl_led_init();","+","+  /* Green LED ON: FSBL started */","+","+  fsbl_led_set(LED_GREEN_PIN, true);","+","   /* Configure power domains for XSPI */"," ","   fsbl_config_vdd();"," ","+  /* Blink red LED twice: VDD configured */","+","+  fsbl_led_blink(LED_RED_PIN, 2);","+","   /* Initialize XSPI2 and enable memory-mapped flash */"," ","   stm32n6_xspi_initialize();"," ","+  /* Blink blue LED 3 times: XSPI ready */","+","+  fsbl_led_blink(LED_BLUE_PIN, 3);","+","+  /*