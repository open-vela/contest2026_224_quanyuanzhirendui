*****************/\n41\t\n42\t/****************************************************************************\n43\t * Name: stm32_board_initialize\n44\t *\n45\t * Description:\n46\t *   All STM32 architectures must provide the following entry point.  This\n47\t *   entry point is called early in the initialization -- after all memory\n48\t *   has been configured and mapped but before any devices have been\n49\t *   initialized.\n50\t *\n51\t ****************************************************************************/\n52\t\n53\tvoid stm32_board_initialize(void)\n54\t{\n55\t#ifdef CONFIG_ARCH_LEDS\n56\t  /* Configure on-board LEDs if LED support has been selected. */\n57\t\n58\t  board_autoled_initialize();\n59\t#endif\n60\t}\n61\t\n62\t/****************************************************************************\n63\t * Name: board_late_initialize\n64\t *\n65\t * Description:\n66\t *   If CONFIG_BOARD_LATE_INITIALIZE is selected, then an additional\n67\t *   initialization call will be performed in the boot-up sequence to a\n68\t *   function called board_late_initialize().  board_late_initialize() will\n69\t *   be called immediately after up_initialize() is called and just before\n70\t *   the initial application is started.  This additional initialization\n71\t *   phase may be used, for example, to initialize board-specific device\n72\t *   drivers.\n73\t *\n74\t ****************************************************************************/\n75\t\n76\t#ifdef CONFIG_BOARD_LATE_INITIALIZE\n77\tvoid board_late_initialize(void)\n78\t{\n79\t  /* Perform board-specific initialization here if so configured */\n80\t\n81\t  stm32_bringup();\n82\t}\n83\t#endif\n84\t"}]},"uuid":"0836e5a5-622c-4ab1-bde0-7897cd63a181","timestamp":"2026-08-20T09:55:40.846Z","toolUseResult":{"type":"text","file":{"filePath":"/home/warner/openvela/nuttx/boards/arm/stm32n6/nucleo-n657x0-q/src/stm32_boot.c","content":"/****************************************************************************\n 