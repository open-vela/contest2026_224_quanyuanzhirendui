  CONFIG_BOARD_LATE_INITIALIZE=n && CONFIG_BOARDCTL=y :\n *     Called from the NSH library\n *\n ****************************************************************************/\n\nint stm32_bringup(void);\n\n#endif /* __ASSEMBLY__ */\n#endif /* __VENDOR_OPENVELA_BOARDS_CONTEST2026_224_BOARD_SRC_CONTEST_BOARD_H */\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"a5367cc8-c02b-4022-820f-2d00fe16b0aa","userType":"external","entrypoint":"claude-vscode","cwd":"/home/warner/openvela","sessionId":"6ad13cb3-6473-4031-a8c5-8ad621057323","version":"2.1.237","gitBranch":"HEAD"}
