XSPI_PRESCALER\n39\t#define MICROPY_HW_XSPI_PRESCALER (4) // F_CLK = F_AHB/4\n40\t#endif\n41\t\n42\t#ifndef MICROPY_HW_XSPI_CS_HIGH_CYCLES\n43\t#define MICROPY_HW_XSPI_CS_HIGH_CYCLES (2) // nCS stays high for 4 cycles\n44\t#endif\n45\t\n46\t// Currently hard-coded to use XSPI2 instance.\n47\t#define XSPIx (XSPI2)\n48\t\n49\t// For XSPI2, PN0 through PN12.\n50\t#define XSPI2_AF (9)\n51\t\n52\ttypedef struct _xspi_flash_t {\n53\t    XSPI_TypeDef *xspi;\n54\t    uintptr_t xip_base;\n55\t} xspi_flash_t;\n56\t\n57\tconst xspi_flash_t xspi_flash1 = {\n58\t    .xspi = XSPI1,\n59\t    .xip_base = 0x90000000,\n60\t};\n61\t\n62\tconst xspi_flash_t xspi_flash2 = {\n63\t    .xspi = XSPI2,\n64\t    .xip_base = 0x70000000,\n65\t};\n66\t\n67\tstatic bool xspi_dtr_enabled = false;\n68\t\n69\t#ifdef pyb_pin_FLASH_RESET\n70\t// Can't rely on SysTick being available, so use a busy loop for delays.\n71\t// The timing here is approximate and assumes a CPU frequency of 800MHz.\n72\tstatic void xspi_delay_us(unsigned int us) {\n73\t    while (us--) {\n74\t        for (unsigned int i = 0; i < 800; ++i) {\n75\t            __NOP();\n76\t        }\n77\t    }\n78\t}\n79\t#endif\n80\t\n81\tstatic inline void mp_hal_pin_config_alt_speed(mp_hal_pin_obj_t pin, uint32_t pull, uint32_t alt, uint32_t speed) {\n82\t    mp_hal_pin_config(pin, MP_HAL_PIN_MODE_ALT, pull, alt);\n83\t    mp_hal_pin_config_speed(pin, speed);\n84\t}\n85\t\n86\tstatic int xspi_read_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, uint8_t *dest);\n87\tstatic int xspi_write_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, const uint8_t *src);\n88\tstatic int xspi_read_888_dtr_ext(uint16_t cmd, bool addr_enabled, uint32_t addr, uint32_t num_dummy, size_t len, uint8_t *dest);\n89\tstatic int xspi_write_888_dtr_ext(uint16_t cmd, bool addr_enabled, uint32_t addr, size_t len, const uint8_t *src);\n90\tstatic void xspi_memory_map_111(void);\n91\tstatic void xspi_memory_map_888(void);\n92\tstatic void xspi_memory_map_exit(void);\n93\t\n94\tvoid xspi_init(void) {\n95\t    // Configure XSPI pins.\n96\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_CS, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n97\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_SCK, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n98\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_DQS, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n99\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO0, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n100\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO1, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n101\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO2, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n102\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO3, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n103\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO4, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n104\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO5, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n105\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO6, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n106\t    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO7, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n107\t\n108\t    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPIM);\n109\t    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPI1);\n110\t    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPI2);\n111\t    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPI3);\n112\t\n113\t    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPIM);\n114\t    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPI1);\n115\t    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPI2);\n116\t    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPI3);\n117\t\n118\t    LL_RCC_SetXSPIClockSource(LL_RCC_XSPI1_CLKSOURCE_HCLK);\n119\t    LL_RCC_SetXSPIClockSource(LL_RCC_XSPI2_CLKSOURCE_HCLK);\n120\t\n121\t    LL_AHB5_GRP1_EnableClock(LL_AHB5_GRP1_PERIPH_XSPIM);\n122\t    LL_AHB5_GRP1_EnableClock(LL_AHB5_GRP1_PERIPH_XSPI1);\n123\t    LL_AHB5_GRP1_EnableClock(LL_AHB5_GRP1_PERIPH_XSPI2);\n124\t\n125\t    // Configure XSPIM in direct mode.\n126\t    XSPI1->CR &= ~XSPI_CR_EN;\n127\t    XSPI2->CR &= ~XSPI_CR_EN;\n128\t    XSPIM->CR = 0;\n129\t\n130\t    // Configure the XSPIx peripheral.\n131\t\n132\t    XSPIx->CR =\n133\t        3 << XSPI_CR_FTHRES_Pos // 4 byte must be available to read/write\n134\t            | 0 << XSPI_CR_MSEL_Pos // FLASH 0 selected\n135\t            | 0 << XSPI_CR_CSSEL_Pos // use NCS1 as chip select\n136\t            | 0 << XSPI_CR_DMM_Pos // dual-memory mode disabled\n137\t            | 1 << XSPI_CR_TCEN_Pos // time-out counter enabled\n138\t            | 0 << XSPI_CR_DMAEN_Pos // DMA disabled\n139\t            | 0 << XSPI_CR_ABORT_Pos // no abort request\n140\t            | 0 << XSPI_CR_EN_Pos // disabled\n141\t    ;\n142\t\n143\t    XSPIx->DCR1 =\n144\t        1 << XSPI_DCR1_MTYP_Pos // Macronix mode\n145\t            | (MICROPY_HW_XSPIFLASH_SIZE_BITS_LOG2 - 3 - 1) << XSPI_DCR1_DEVSIZE_Pos\n146\t            | (MICROPY_HW_XSPI_CS_HIGH_CYCLES - 1) << XSPI_DCR1_CSHT_Pos\n147\t            | 0 << XSPI_DCR1_FRCK_Pos // CLK is not free running\n148\t            | 0 << XSPI_DCR1_CKMODE_Pos // CLK idles at low state\n149\t    ;\n150\t\n151\t    XSPIx->DCR2 =\n152\t        0 << XSPI_DCR2_WRAPSIZE_Pos // separate wrap reads are not supported by the memory\n153\t            | (MICROPY_HW_XSPI_PRESCALER - 1) << XSPI_DCR2_PRESCALER_Pos\n154\t    ;\n155\t\n156\t    XSPIx->DCR3 =\n157\t        0\n158\t        // 10 << XSPI_DCR3_CSBOUND_Pos // transaction boundary at 1024\n159\t    ;\n160\t\n161\t    XSPIx->DCR4 =\n162\t        0 << XSPI_DCR4_REFRESH_Pos // refresh disabled (it's non-volatile memory)\n163\t    ;\n164\t\n165\t    XSPIx->TCR = 0;\n166\t\n167\t    // Enable the XSPI peripheral.\n168\t    XSPIx->CR |= XSPI_CR_EN;\n169\t\n170\t    // XSPIM init\n171\t    XSPI1->CR &= ~(1 << XSPI_CR_EN_Pos);\n172\t    XSPI2->CR &= ~(1 << XSPI_CR_EN_Pos);\n173\t    XSPIM->CR = 0; // can also be (1 << 4) to pass through CS signal\n174\t    XSPIx->CR |= 1 << XSPI_CR_EN_Pos;\n175\t\n176\t    #ifdef pyb_pin_FLASH_RESET\n177\t    // Reset SPI flash to make sure it's in a known state (SPI mode).\n178\t    mp_hal_pin_output(pyb_pin_FLASH_RESET);\n179\t    mp_hal_pin_low(pyb_pin_FLASH_RESET);\n180\t    xspi_delay_us(1000);\n181\t    mp_hal_pin_high(pyb_pin_FLASH_RESET);\n182\t    xspi_delay_us(10000);\n183\t    #endif\n184\t\n185\t    // Enable memory-mapped mode.\n186\t    // Can select either SPI or DTR mode.\n187\t    if (1) {\n188\t        xspi_switch_to_dtr();\n189\t        xspi_memory_map_888();\n190\t    } else {\n191\t        xspi_memory_map_111();\n192\t    }\n193\t}\n194\t\n195\tuint32_t xspi_get_xip_base(const xspi_flash_t *self) {\n196\t    return self->xip_base;\n197\t}\n198\t\n199\tbool xspi_is_valid_addr(const xspi_flash_t *self, uint32_t addr) {\n200\t    return self->xip_base <= addr && addr < self->xip_base + 256 * 1024 * 1024;\n201\t}\n202\t\n203\tstatic int xspi_read_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, uint8_t *dest) {\n204\t    uint32_t admode = addr_enabled ? 1 : 0;\n205\t    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 1 << XSPI_CR_FMODE_Pos; // indirect read mode\n206\t    XSPIx->CCR =\n207\t        1 << XSPI_CCR_DMODE_Pos // data on 1 line\n208\t            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address size\n209\t            | admode << XSPI_CCR_ADMODE_Pos // address on 1 line, or disabled\n210\t            | 1 << XSPI_CCR_IMODE_Pos // instruction on 1 line\n211\t    ;\n212\t    XSPIx->TCR = 0 << XSPI_TCR_DCYC_Pos; // 0 dummy cycles\n213\t    XSPIx->DLR = len - 1; // number of bytes to read\n214\t    XSPIx->IR = cmd; // read opcode (triggers the start of the transaction if address disabled)\n215\t    if (addr_enabled) {\n216\t        XSPIx->AR = addr; // triggers the start of the transaction\n217\t    }\n218\t\n219\t    #if 0 // untested code\n220\t    // Read in the data 4 bytes at a time if dest is aligned.\n221\t    if (((uintptr_t)dest & 3) == 0) {\n222\t        while (len >= 4) {\n223\t            while (!(XSPIx->SR & XSPI_SR_FTF)) {\n224\t                if (XSPIx->SR & XSPI_SR_TEF) {\n225\t                    return -MP_EIO;\n226\t                }\n227\t            }\n228\t            *(uint32_t *)dest = XSPIx->DR;\n229\t            dest += 4;\n230\t            len -= 4;\n231\t        }\n232\t    }\n233\t    #endif\n234\t\n235\t    // Read in data 1 byte at a time.\n236\t    while (len--) {\n237\t        while (!((XSPIx->SR >> XSPI_SR_FLEVEL_Pos) & 0x3f)) {\n238\t            if (XSPIx->SR & XSPI_SR_TEF) {\n239\t                return -MP_EIO;\n240\t            }\n241\t        }\n242\t        *dest++ = *(volatile uint8_t *)&XSPIx->DR;\n243\t    }\n244\t\n245\t    XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n246\t\n247\t    return 0;\n248\t}\n249\t\n250\tstatic int xspi_write_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, const uint8_t *src) {\n251\t    uint32_t dmode = len == 0 ? 0 : 1;\n252\t    uint32_t admode = addr_enabled ? 1 : 0;\n253\t\n254\t    // Configure and start the transfer.\n255\t    // Transfer starts with IR write if no address or data, with AR write if no data,\n256\t    // otherwise with DR write.\n257\t\n258\t    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 0 << XSPI_CR_FMODE_Pos; // indirect write mode\n259\t    XSPIx->CCR =\n260\t        dmode << XSPI_CCR_DMODE_Pos // data on 1 line, or disabled\n261\t            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address size\n262\t            | admode << XSPI_CCR_ADMODE_Pos // address on 1 line, or disabled\n263\t            | 1 << XSPI_CCR_IMODE_Pos // instruction on 1 line\n264\t    ;\n265\t    XSPIx->TCR = 0 << XSPI_TCR_DCYC_Pos; // 0 dummy cycles\n266\t    if (len != 0) {\n267\t        XSPIx->DLR = len - 1;\n268\t    }\n269\t    XSPIx->IR = cmd; // write opcode\n270\t    if (addr_enabled) {\n271\t        XSPIx->AR = addr; // address\n272\t    }\n273\t\n274\t    // Write out the data one byte at a time\n275\t    while (len--) {\n276\t        while (!(XSPIx->SR & XSPI_SR_FTF)) {\n277\t            if (XSPIx->SR & XSPI_SR_TEF) {\n278\t                return -MP_EIO;\n279\t            }\n280\t        }\n281\t        *(volatile uint8_t *)&XSPIx->DR = *src++;\n282\t    }\n283\t\n284\t    // Wait for write to finish\n285\t    while (!(XSPIx->SR & XSPI_SR_TCF)) {\n286\t        if (XSPIx->SR & XSPI_SR_TEF) {\n287\t            return -MP_EIO;\n288\t        }\n289\t    }\n290\t\n291\t    XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n292\t\n293\t    // Wait for peripheral to return to idle.\n294\t    while (XSPIx->SR & XSPI_SR_BUSY) {\n295\t    }\n296\t\n297\t    return 0;\n298\t}\n299\t\n300\tstatic int xspi_read_888_dtr_ext(uint16_t cmd, bool addr_enabled, uint32_t addr, uint32_t num_dummy, size_t len, uint8_t *dest) {\n301\t    uint32_t admode = addr_enabled ? 4 : 0;\n302\t\n303\t    // Configure and start the transfer.\n304\t    // Transfer starts with IR write if no address, otherwise with AR write.\n305\t\n306\t    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 1 << XSPI_CR_FMODE_Pos; // indirect read mode\n307\t    XSPIx->CCR =\n308\t        1 << XSPI_CCR_DQSE_Pos // DQS enabled\n309\t            | 1 << XSPI_CCR_DDTR_Pos // data DTR enabled\n310\t            | 4 << XSPI_CCR_DMODE_Pos // data on 8 lines\n311\t            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address size\n312\t            | 1 << XSPI_CCR_ADDTR_Pos // address DTR enabled\n313\t            | admode << XSPI_CCR_ADMODE_Pos // address on 8 lines, or disabled\n314\t            | 1 << XSPI_CCR_ISIZE_Pos // 16-bit instruction\n315\t            | 1 << XSPI_CCR_IDTR_Pos // instruction DTR enabled\n316\t            | 4 << XSPI_CCR_IMODE_Pos // instruction on 8 lines\n317\t    ;\n318\t    XSPIx->TCR = num_dummy << XSPI_TCR_DCYC_Pos; // N dummy cycles\n319\t    XSPIx->DLR = len - 1;\n320\t    XSPIx->IR = cmd; // read opcode\n321\t    if (addr_enabled) {\n322\t        XSPIx->AR = addr; // address\n323\t    }\n324\t\n325\t    // Read in data 1 byte at a time.\n326\t    while (len--) {\n327\t        while (!((XSPIx->SR >> XSPI_SR_FLEVEL_Pos) & 0x3f)) {\n328\t            if (XSPIx->SR & XSPI_SR_TEF) {\n329\t                return -MP_EIO;\n330\t            }\n331\t        }\n332\t        *dest++ = *(volatile uint8_t *)&XSPIx->DR;\n333\t    }\n334\t\n335\t    XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n336\t\n337\t    return 0;\n338\t}\n339\t\n340\tstatic int xspi_write_888_dtr_ext(uint16_t cmd, bool addr_enabled, uint32_t addr, size_t len, const uint8_t *src) {\n341\t    uint32_t dmode = len == 0 ? 0 : 4;\n342\t    uint32_t admode = addr_enabled ? 4 : 0;\n343\t\n344\t    // Configure and start the transfer.\n345\t    // Transfer starts with IR write if no address or data, with AR write if no data,\n346\t    // otherwise with DR write.\n347\t\n348\t    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 0 << XSPI_CR_FMODE_Pos; // indirect write mode\n349\t    XSPIx->CCR =\n350\t        1 << XSPI_CCR_DDTR_Pos // data DTR enabled\n351\t            | dmode << XSPI_CCR_DMODE_Pos // data on 8 lines, or disabled\n352\t            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address size\n353\t            | 1 << XSPI_CCR_ADDTR_Pos // address DTR enabled\n354\t            | admode << XSPI_CCR_ADMODE_Pos // address on 8 lines, or disabled\n355\t            | 1 << XSPI_CCR_ISIZE_Pos // 16-bit instruction\n356\t            | 1 << XSPI_CCR_IDTR_Pos // instruction DTR enabled\n357\t            | 4 << XSPI_CCR_IMODE_Pos // instruction on 8 lines\n358\t    ;\n359\t    XSPIx->TCR = 0 << XSPI_TCR_DCYC_Pos; // 0 dummy cycles\n360\t    if (len != 0) {\n361\t        XSPIx->DLR = len - 1;\n362\t    }\n363\t    XSPIx->IR = cmd; // write opcode\n364\t    if (addr_enabled) {\n365\t        XSPIx->AR = addr; // address\n366\t    }\n367\t\n368\t    // Write out the data one byte at a time\n369\t    while (len--) {\n370\t        while (!(XSPIx->SR & XSPI_SR_FTF)) {\n371\t            if (XSPIx->SR & XSPI_SR_TEF) {\n372\t                return -MP_EIO;\n373\t            }\n374\t        }\n375\t        *(volatile uint8_t *)&XSPIx->DR = *src++;\n376\t    }\n377\t\n378\t    // Wait for write to finish\n379\t    while (!(XSPIx->SR & XSPI_SR_TCF)) {\n380\t        if (XSPIx->SR & XSPI_SR_TEF) {\n381\t            return -MP_EIO;\n382\t        }\n383\t    }\n384\t\n385\t    XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n386\t\n387\t    // Wait for peripheral to return to idle.\n388\t    while (XSPIx->SR & XSPI_SR_BUSY) {\n389\t    }\n390\t\n391\t    return 0;\n392\t}\n393\t\n394\tstatic void xspi_memory_map_111(void) {\n395\t    XSPIx->CCR =\n396\t        1 << XSPI_CCR_DMODE_Pos // data on 1 line\n397\t            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address\n398\t            | 1 << XSPI_CCR_ADMODE_Pos // address on 1 line\n399\t            | 1 << XSPI_CCR_IMODE_Pos // instruction on 1 line\n400\t    ;\n401\t\n402\t    XSPIx->TCR = 0 << XSPI_TCR_DCYC_Pos; // no dummy cycles\n403\t    XSPIx->IR = 0x13; // READ4B\n404\t    XSPIx->LPTR = 1024; // timeout period in number of CLK cycles\n405\t\n406\t    // Enable the XSPI peripheral in memory-mapped mode.\n407\t    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 3 << XSPI_CR_FMODE_Pos;\n408\t}\n409\t\n410\tstatic void xspi_memory_map_888(void) {\n411\t    XSPIx->CCR =\n412\t        1 << XSPI_CCR_DQSE_Pos // DQS enabled\n413\t            | 1 << XSPI_CCR_DDTR_Pos // data DTR enabled\n414\t            | 4 << XSPI_CCR_DMODE_Pos // data on 8 lines\n415\t            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address\n416\t            | 1 << XSPI_CCR_ADDTR_Pos // address DTR enabled\n417\t            | 4 << XSPI_CCR_ADMODE_Pos // address on 8 lines\n418\t            | 1 << XSPI_CCR_ISIZE_Pos // 16-bit instruction\n419\t            | 1 << XSPI_CCR_IDTR_Pos // instruction DTR enabled\n420\t            | 4 << XSPI_CCR_IMODE_Pos // instruction on 8 lines\n421\t    ;\n422\t\n423\t    XSPIx->TCR = 20 << XSPI_TCR_DCYC_Pos; // 20 dummy cycles for reading (minimum, flash may insert more by holding DQS low)\n424\t    XSPIx->IR = 0xee11; // octal DTR read mode (8DTRD)\n425\t    XSPIx->LPTR = 1024; // timeout period in number of CLK cycles\n426\t\n427\t    // Enable the XSPI peripheral in memory-mapped mode.\n428\t    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 3 << XSPI_CR_FMODE_Pos;\n429\t}\n430\t\n431\tstatic void xspi_memory_map_exit(void) {\n432\t    // Abort any ongoing transfer if peripheral is busy.\n433\t    if (XSPIx->SR & XSPI_SR_BUSY) {\n434\t        XSPIx->CR |= XSPI_CR_ABORT;\n435\t        while (!(XSPIx->SR & XSPI_SR_TCF)) {\n436\t        }\n437\t        XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n438\t        while (XSPIx->SR & XSPI_SR_BUSY) {\n439\t        }\n440\t    }\n441\t    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 0 << XSPI_CR_FMODE_Pos; // indirect write mode\n442\t}\n443\t\n444\tvoid xspi_switch_to_dtr(void) {\n445\t    uint8_t buf[4];\n446\t\n447\t    // WREN.\n448\t    xspi_write_111_ext(0x06, false, 0, 0, NULL);\n449\t\n450\t    // Wait WEL=1, with small timeout.\n451\t    for (unsigned int i = 0; i < 100; ++i) {\n452\t        xspi_read_111_ext(0x05, false, 0, 1, buf);\n453\t        if (buf[0] & 2) {\n454\t            break;\n455\t        }\n456\t    }\n457\t\n458\t    // Switch to DOPI DTR mode.\n459\t    buf[0] = 2;\n460\t    xspi_write_111_ext(0x72, true, 0x00000000, 1, buf);\n461\t\n462\t    xspi_dtr_enabled = true;\n463\t}\n464\t\n465\tvoid xspi_switch_to_spi(void) {\n466\t    uint8_t buf[4];\n467\t\n468\t    // WREN.\n469\t    xspi_write_888_dtr_ext(0x06f9, false, 0, 0, NULL);\n470\t\n471\t    // Wait WEL=1, with small timeout.\n472\t    for (unsigned int i = 0; i < 100; ++i) {\n473\t        xspi_read_111_ext(0x05, false, 0, 1, buf);\n474\t        if (buf[0] & 2) {\n475\t            break;\n476\t        }\n477\t    }\n478\t\n479\t    // Switch to SPI mode.\n480\t    buf[0] = 0;\n481\t    buf[1] = 0;\n482\t    xspi_write_888_dtr_ext(0x728d, true, 0x00000000, 2, buf);\n483\t\n484\t    xspi_dtr_enabled = false;\n485\t}\n486\t\n487\tstatic int xspi_ioctl(void *self_in, uint32_t cmd, uintptr_t arg) {\n488\t    xspi_flash_t *self = self_in;\n489\t    switch (cmd) {\n490\t        case MP_QSPI_IOCTL_INIT:\n491\t            // XSPI must be manually initialise by calling `xspi_init()` at boot.\n492\t            // Here, just determine if it's in SPI or DTR mode.\n493\t            xspi_dtr_enabled = XSPIx->IR == 0xee11;\n494\t            break;\n495\t        case MP_QSPI_IOCTL_BUS_ACQUIRE:\n496\t            xspi_memory_map_exit();\n497\t            break;\n498\t        case MP_QSPI_IOCTL_BUS_RELEASE:\n499\t            if (xspi_dtr_enabled) {\n500\t                xspi_memory_map_888();\n501\t            } else {\n502\t                xspi_memory_map_111();\n503\t            }\n504\t            break;\n505\t        case MP_QSPI_IOCTL_MEMORY_MODIFIED: {\n506\t            uintptr_t *addr_len = (uintptr_t *)arg;\n507\t            volatile void *addr = (volatile void *)(self->xip_base + addr_len[0]);\n508\t            size_t len = addr_len[1];\n509\t            SCB_InvalidateICache_by_Addr(addr, len);\n510\t            SCB_InvalidateDCache_by_Addr(addr, len);\n511\t            break;\n512\t        }\n513\t    }\n514\t    return 0; // success\n515\t}\n516\t\n517\t// These commands may be passed to this function.\n518\t#define CMD_WREN        (0x06)\n519\t#define CMD_RSTEN       (0x66)\n520\t#define CMD_RESET       (0x99)\n521\t#define CMD_SLEEP       (0xb9)\n522\t#define CMD_AWAKE       (0xab)\n523\tstatic int xspi_write_cmd_data(void *self_in, uint8_t cmd, size_t len, uint32_t data) {\n524\t    if (xspi_dtr_enabled) {\n525\t        uint16_t cmd16 = 0;\n526\t        if (cmd == CMD_WREN) {\n527\t            cmd16 = 0x06f9;\n528\t        } else if (cmd == CMD_SLEEP) {\n529\t            cmd16 = 0xb946;\n530\t        } else if (cmd == CMD_AWAKE) {\n531\t            cmd16 = 0xab54;\n532\t        }\n533\t        return xspi_write_888_dtr_ext(cmd16, false, 0, len, (const uint8_t *)&data);\n534\t    }\n535\t    return xspi_write_111_ext(cmd, false, 0, len, (const uint8_t *)&data);\n536\t}\n537\t\n538\t// These commands may be passed to this function.\n539\t#define CMD_WRITE       (0x02)\n540\t#define CMD_WRITE_32    (0x12)\n541\t#define CMD_SEC_ERASE   (0x20)\n542\t#define CMD_SEC_ERASE_32 (0x21)\n543\tstatic int xspi_write_cmd_addr_data(void *self_in, uint8_t cmd, uint32_t addr, size_t len, const uint8_t *src) {\n544\t    // Convert 24-bit address commands to 32-bit address commands.\n545\t    if (cmd == CMD_WRITE) {\n546\t        cmd = CMD_WRITE_32;\n547\t    } else if (cmd == CMD_SEC_ERASE) {\n548\t        cmd = CMD_SEC_ERASE_32;\n549\t    }\n550\t    if (xspi_dtr_enabled) {\n551\t        uint16_t cmd16 = 0;\n552\t        if (cmd == CMD_WRITE_32) {\n553\t            cmd16 = 0x12ed;\n554\t        } else if (cmd == CMD_SEC_ERASE_32) {\n555\t            cmd16 = 0x21de;\n556\t        }\n557\t        return xspi_write_888_dtr_ext(cmd16, true, addr, len, src);\n558\t    }\n559\t    return xspi_write_111_ext(cmd, true, addr, len, src);\n560\t}\n561\t\n562\t// These commands may be passed to this function.\n563\t#define CMD_RDSR        (0x05)\n564\t#define CMD_RD_DEVID    (0x9f)\n565\tstatic int xspi_read_cmd(void *self_in, uint8_t cmd, size_t len, uint32_t *dest) {\n566\t    (void)self_in;\n567\t    if (xspi_dtr_enabled) {\n568\t        uint16_t cmd16 = 0;\n569\t        uint32_t num_dummy = 0;\n570\t        if (cmd == CMD_RDSR) {\n571\t            cmd16 = 0x05fa;\n572\t            num_dummy = 4;\n573\t            len = 2;\n574\t        } else if (cmd == CMD_RD_DEVID) {\n575\t            // TODO this doesn't really work, because result is in STR format.\n576\t            cmd16 = 0x9f60;\n577\t            num_dummy = 4;\n578\t        }\n579\t        return xspi_read_888_dtr_ext(cmd16, true, 0, num_dummy, len, (uint8_t *)dest);\n580\t    }\n581\t    return xspi_read_111_ext(cmd, false, 0, len, (uint8_t *)dest);\n582\t}\n583\t\n584\tstatic int xspi_direct_read(void *self_in, uint32_t addr, size_t len, uint8_t *dest) {\n585\t    xspi_flash_t *self = self_in;\n586\t    memcpy(dest, (const void *)(self->xip_base + addr), len);\n587\t    return 0;\n588\t}\n589\t\n590\tconst mp_qspi_proto_t xspi_proto = {\n591\t    .ioctl = xspi_ioctl,\n592\t    .write_cmd_data = xspi_write_cmd_data,\n593\t    .write_cmd_addr_data = xspi_write_cmd_addr_data,\n594\t    .read_cmd = xspi_read_cmd,\n595\t    .read_cmd_qaddr_qdata = NULL, // unused because .direct_read is set below, and caching is disabled\n596\t    .direct_read = xspi_direct_read,\n597\t};\n598\t\n599\t#endif // defined(MICROPY_HW_XSPIFLASH_SIZE_BITS_LOG2)\n600\t"}]},"uuid":"2c4a9867-15a8-4ce6-afad-92810c91a653","timestamp":"2026-08-21T01:59:25.775Z","toolUseResult":{"type":"text","file":{"filePath":"/home/warner/openvela/atk-dnn647-micropython/ports/stm32/xspi.c","content":"/*\n * This file is part of the MicroPython project, http://micropython.org/\n *\n * The MIT License (MIT)\n *\n * Copyright (c) 2024-2025 Damien P. George\n *\n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n *\n * The above copyright notice and this permission notice shall be included in\n * all copies or substantial portions of the Software.\n *\n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n * THE SOFTWARE.\n */\n\n// This XSPI driver is currently configured to run in 1-line (SPI) mode.\n// It uses the mp_qspi_proto_t QSPI protocol and translates quad-commands\n// into 1-line commands.\n\n#include <string.h>\n#include \"py/mperrno.h\"\n#include \"py/mphal.h\"\n#include \"xspi.h\"\n\n#if defined(MICROPY_HW_XSPIFLASH_SIZE_BITS_LOG2)\n\n#ifndef MICROPY_HW_XSPI_PRESCALER\n#define MICROPY_HW_XSPI_PRESCALER (4) // F_CLK = F_AHB/4\n#endif\n\n#ifndef MICROPY_HW_XSPI_CS_HIGH_CYCLES\n#define MICROPY_HW_XSPI_CS_HIGH_CYCLES (2) // nCS stays high for 4 cycles\n#endif\n\n// Currently hard-coded to use XSPI2 instance.\n#define XSPIx (XSPI2)\n\n// For XSPI2, PN0 through PN12.\n#define XSPI2_AF (9)\n\ntypedef struct _xspi_flash_t {\n    XSPI_TypeDef *xspi;\n    uintptr_t xip_base;\n} xspi_flash_t;\n\nconst xspi_flash_t xspi_flash1 = {\n    .xspi = XSPI1,\n    .xip_base = 0x90000000,\n};\n\nconst xspi_flash_t xspi_flash2 = {\n    .xspi = XSPI2,\n    .xip_base = 0x70000000,\n};\n\nstatic bool xspi_dtr_enabled = false;\n\n#ifdef pyb_pin_FLASH_RESET\n// Can't rely on SysTick being available, so use a busy loop for delays.\n// The timing here is approximate and assumes a CPU frequency of 800MHz.\nstatic void xspi_delay_us(unsigned int us) {\n    while (us--) {\n        for (unsigned int i = 0; i < 800; ++i) {\n            __NOP();\n        }\n    }\n}\n#endif\n\nstatic inline void mp_hal_pin_config_alt_speed(mp_hal_pin_obj_t pin, uint32_t pull, uint32_t alt, uint32_t speed) {\n    mp_hal_pin_config(pin, MP_HAL_PIN_MODE_ALT, pull, alt);\n    mp_hal_pin_config_speed(pin, speed);\n}\n\nstatic int xspi_read_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, uint8_t *dest);\nstatic int xspi_write_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, const uint8_t *src);\nstatic int xspi_read_888_dtr_ext(uint16_t cmd, bool addr_enabled, uint32_t addr, uint32_t num_dummy, size_t len, uint8_t *dest);\nstatic int xspi_write_888_dtr_ext(uint16_t cmd, bool addr_enabled, uint32_t addr, size_t len, const uint8_t *src);\nstatic void xspi_memory_map_111(void);\nstatic void xspi_memory_map_888(void);\nstatic void xspi_memory_map_exit(void);\n\nvoid xspi_init(void) {\n    // Configure XSPI pins.\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_CS, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_SCK, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_DQS, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO0, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO1, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO2, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO3, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO4, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO5, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO6, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n    mp_hal_pin_config_alt_speed(pyb_pin_XSPIM_P2_IO7, MP_HAL_PIN_PULL_NONE, XSPI2_AF, MP_HAL_PIN_SPEED_VERY_HIGH);\n\n    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPIM);\n    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPI1);\n    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPI2);\n    LL_AHB5_GRP1_ForceReset(LL_AHB5_GRP1_PERIPH_XSPI3);\n\n    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPIM);\n    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPI1);\n    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPI2);\n    LL_AHB5_GRP1_ReleaseReset(LL_AHB5_GRP1_PERIPH_XSPI3);\n\n    LL_RCC_SetXSPIClockSource(LL_RCC_XSPI1_CLKSOURCE_HCLK);\n    LL_RCC_SetXSPIClockSource(LL_RCC_XSPI2_CLKSOURCE_HCLK);\n\n    LL_AHB5_GRP1_EnableClock(LL_AHB5_GRP1_PERIPH_XSPIM);\n    LL_AHB5_GRP1_EnableClock(LL_AHB5_GRP1_PERIPH_XSPI1);\n    LL_AHB5_GRP1_EnableClock(LL_AHB5_GRP1_PERIPH_XSPI2);\n\n    // Configure XSPIM in direct mode.\n    XSPI1->CR &= ~XSPI_CR_EN;\n    XSPI2->CR &= ~XSPI_CR_EN;\n    XSPIM->CR = 0;\n\n    // Configure the XSPIx peripheral.\n\n    XSPIx->CR =\n        3 << XSPI_CR_FTHRES_Pos // 4 byte must be available to read/write\n            | 0 << XSPI_CR_MSEL_Pos // FLASH 0 selected\n            | 0 << XSPI_CR_CSSEL_Pos // use NCS1 as chip select\n            | 0 << XSPI_CR_DMM_Pos // dual-memory mode disabled\n            | 1 << XSPI_CR_TCEN_Pos // time-out counter enabled\n            | 0 << XSPI_CR_DMAEN_Pos // DMA disabled\n            | 0 << XSPI_CR_ABORT_Pos // no abort request\n            | 0 << XSPI_CR_EN_Pos // disabled\n    ;\n\n    XSPIx->DCR1 =\n        1 << XSPI_DCR1_MTYP_Pos // Macronix mode\n            | (MICROPY_HW_XSPIFLASH_SIZE_BITS_LOG2 - 3 - 1) << XSPI_DCR1_DEVSIZE_Pos\n            | (MICROPY_HW_XSPI_CS_HIGH_CYCLES - 1) << XSPI_DCR1_CSHT_Pos\n            | 0 << XSPI_DCR1_FRCK_Pos // CLK is not free running\n            | 0 << XSPI_DCR1_CKMODE_Pos // CLK idles at low state\n    ;\n\n    XSPIx->DCR2 =\n        0 << XSPI_DCR2_WRAPSIZE_Pos // separate wrap reads are not supported by the memory\n            | (MICROPY_HW_XSPI_PRESCALER - 1) << XSPI_DCR2_PRESCALER_Pos\n    ;\n\n    XSPIx->DCR3 =\n        0\n        // 10 << XSPI_DCR3_CSBOUND_Pos // transaction boundary at 1024\n    ;\n\n    XSPIx->DCR4 =\n        0 << XSPI_DCR4_REFRESH_Pos // refresh disabled (it's non-volatile memory)\n    ;\n\n    XSPIx->TCR = 0;\n\n    // Enable the XSPI peripheral.\n    XSPIx->CR |= XSPI_CR_EN;\n\n    // XSPIM init\n    XSPI1->CR &= ~(1 << XSPI_CR_EN_Pos);\n    XSPI2->CR &= ~(1 << XSPI_CR_EN_Pos);\n    XSPIM->CR = 0; // can also be (1 << 4) to pass through CS signal\n    XSPIx->CR |= 1 << XSPI_CR_EN_Pos;\n\n    #ifdef pyb_pin_FLASH_RESET\n    // Reset SPI flash to make sure it's in a known state (SPI mode).\n    mp_hal_pin_output(pyb_pin_FLASH_RESET);\n    mp_hal_pin_low(pyb_pin_FLASH_RESET);\n    xspi_delay_us(1000);\n    mp_hal_pin_high(pyb_pin_FLASH_RESET);\n    xspi_delay_us(10000);\n    #endif\n\n    // Enable memory-mapped mode.\n    // Can select either SPI or DTR mode.\n    if (1) {\n        xspi_switch_to_dtr();\n        xspi_memory_map_888();\n    } else {\n        xspi_memory_map_111();\n    }\n}\n\nuint32_t xspi_get_xip_base(const xspi_flash_t *self) {\n    return self->xip_base;\n}\n\nbool xspi_is_valid_addr(const xspi_flash_t *self, uint32_t addr) {\n    return self->xip_base <= addr && addr < self->xip_base + 256 * 1024 * 1024;\n}\n\nstatic int xspi_read_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, uint8_t *dest) {\n    uint32_t admode = addr_enabled ? 1 : 0;\n    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 1 << XSPI_CR_FMODE_Pos; // indirect read mode\n    XSPIx->CCR =\n        1 << XSPI_CCR_DMODE_Pos // data on 1 line\n            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address size\n            | admode << XSPI_CCR_ADMODE_Pos // address on 1 line, or disabled\n            | 1 << XSPI_CCR_IMODE_Pos // instruction on 1 line\n    ;\n    XSPIx->TCR = 0 << XSPI_TCR_DCYC_Pos; // 0 dummy cycles\n    XSPIx->DLR = len - 1; // number of bytes to read\n    XSPIx->IR = cmd; // read opcode (triggers the start of the transaction if address disabled)\n    if (addr_enabled) {\n        XSPIx->AR = addr; // triggers the start of the transaction\n    }\n\n    #if 0 // untested code\n    // Read in the data 4 bytes at a time if dest is aligned.\n    if (((uintptr_t)dest & 3) == 0) {\n        while (len >= 4) {\n            while (!(XSPIx->SR & XSPI_SR_FTF)) {\n                if (XSPIx->SR & XSPI_SR_TEF) {\n                    return -MP_EIO;\n                }\n            }\n            *(uint32_t *)dest = XSPIx->DR;\n            dest += 4;\n            len -= 4;\n        }\n    }\n    #endif\n\n    // Read in data 1 byte at a time.\n    while (len--) {\n        while (!((XSPIx->SR >> XSPI_SR_FLEVEL_Pos) & 0x3f)) {\n            if (XSPIx->SR & XSPI_SR_TEF) {\n                return -MP_EIO;\n            }\n        }\n        *dest++ = *(volatile uint8_t *)&XSPIx->DR;\n    }\n\n    XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n\n    return 0;\n}\n\nstatic int xspi_write_111_ext(uint8_t cmd, bool addr_enabled, uint32_t addr, size_t len, const uint8_t *src) {\n    uint32_t dmode = len == 0 ? 0 : 1;\n    uint32_t admode = addr_enabled ? 1 : 0;\n\n    // Configure and start the transfer.\n    // Transfer starts with IR write if no address or data, with AR write if no data,\n    // otherwise with DR write.\n\n    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 0 << XSPI_CR_FMODE_Pos; // indirect write mode\n    XSPIx->CCR =\n        dmode << XSPI_CCR_DMODE_Pos // data on 1 line, or disabled\n            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address size\n            | admode << XSPI_CCR_ADMODE_Pos // address on 1 line, or disabled\n            | 1 << XSPI_CCR_IMODE_Pos // instruction on 1 line\n    ;\n    XSPIx->TCR = 0 << XSPI_TCR_DCYC_Pos; // 0 dummy cycles\n    if (len != 0) {\n        XSPIx->DLR = len - 1;\n    }\n    XSPIx->IR = cmd; // write opcode\n    if (addr_enabled) {\n        XSPIx->AR = addr; // address\n    }\n\n    // Write out the data one byte at a time\n    while (len--) {\n        while (!(XSPIx->SR & XSPI_SR_FTF)) {\n            if (XSPIx->SR & XSPI_SR_TEF) {\n                return -MP_EIO;\n            }\n        }\n        *(volatile uint8_t *)&XSPIx->DR = *src++;\n    }\n\n    // Wait for write to finish\n    while (!(XSPIx->SR & XSPI_SR_TCF)) {\n        if (XSPIx->SR & XSPI_SR_TEF) {\n            return -MP_EIO;\n        }\n    }\n\n    XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n\n    // Wait for peripheral to return to idle.\n    while (XSPIx->SR & XSPI_SR_BUSY) {\n    }\n\n    return 0;\n}\n\nstatic int xspi_read_888_dtr_ext(uint16_t cmd, bool addr_enabled, uint32_t addr, uint32_t num_dummy, size_t len, uint8_t *dest) {\n    uint32_t admode = addr_enabled ? 4 : 0;\n\n    // Configure and start the transfer.\n    // Transfer starts with IR write if no address, otherwise with AR write.\n\n    XSPIx->CR = (XSPIx->CR & ~XSPI_CR_FMODE_Msk) | 1 << XSPI_CR_FMODE_Pos; // indirect read mode\n    XSPIx->CCR =\n        1 << XSPI_CCR_DQSE_Pos // DQS enabled\n            | 1 << XSPI_CCR_DDTR_Pos // data DTR enabled\n            | 4 << XSPI_CCR_DMODE_Pos // data on 8 lines\n            | 3 << XSPI_CCR_ADSIZE_Pos // 32-bit address size\n            | 1 << XSPI_CCR_ADDTR_Pos // address DTR enabled\n            | admode << XSPI_CCR_ADMODE_Pos // address on 8 lines, or disabled\n            | 1 << XSPI_CCR_ISIZE_Pos // 16-bit instruction\n            | 1 << XSPI_CCR_IDTR_Pos // instruction DTR enabled\n            | 4 << XSPI_CCR_IMODE_Pos // instruction on 8 lines\n    ;\n    XSPIx->TCR = num_dummy << XSPI_TCR_DCYC_Pos; // N dummy cycles\n    XSPIx->DLR = len - 1;\n    XSPIx->IR = cmd; // read opcode\n    if (addr_enabled) {\n        XSPIx->AR = addr; // address\n    }\n\n    // Read in data 1 byte at a time.\n    while (len--) {\n        while (!((XSPIx->SR >> XSPI_SR_FLEVEL_Pos) & 0x3f)) {\n            if (XSPIx->SR & XSPI_SR_TEF) {\n                return -MP_EIO;\n            }\n        }\n        *dest++ = *(volatile uint8_t *)&XSPIx->DR;\n    }\n\n    XSPIx->FCR = XSPI_FCR_CTCF; // clear TC flag\n\n    return 0;\n}\n\nstatic int xspi_w